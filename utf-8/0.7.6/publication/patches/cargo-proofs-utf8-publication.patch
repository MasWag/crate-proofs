+fn generic_owner(owner: &syn::TypePath, generics: &syn::Generics) -> bool {
+    if owner.qself.is_some() || owner.path.leading_colon.is_some() { return false; }
+    let parameters: BTreeSet<_> = generics.params.iter().filter_map(|p| match p {
+        syn::GenericParam::Type(p) => Some(p.ident.to_string()),
+        syn::GenericParam::Const(p) => Some(p.ident.to_string()),
+        _ => None,
+    }).collect();
+    let mut seen = BTreeSet::new();
+    for segment in &owner.path.segments {
+        match &segment.arguments {
+            syn::PathArguments::None => {},
+            syn::PathArguments::Parenthesized(_) => return false,
+            syn::PathArguments::AngleBracketed(args) => for arg in &args.args {
+                let name = match arg {
+                    syn::GenericArgument::Lifetime(_) => continue,
+                    syn::GenericArgument::Type(syn::Type::Path(p)) if p.qself.is_none() => {
+                        let Ok(parts) = segments(&p.path) else { return false; };
+                        if parts.len()!=1 { return false; }
+                        parts[0].clone()
+                    },
+                    syn::GenericArgument::Const(syn::Expr::Path(p)) if p.qself.is_none() => {
+                        let Ok(parts) = segments(&p.path) else { return false; };
+                        if parts.len()!=1 { return false; }
+                        parts[0].clone()
+                    },
+                    _ => return false,
+                };
+                if !parameters.contains(&name) || !seen.insert(name) { return false; }
+            },
+        }
+    }
+    seen == parameters
 }
 
