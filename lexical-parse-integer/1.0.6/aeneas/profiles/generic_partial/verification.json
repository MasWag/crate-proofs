{
  "schema_version": 1,
  "supported_targets": [
    "aarch64-apple-darwin"
  ],
  "native": [
    [
      "cargo",
      "test",
      "--locked",
      "--offline",
      "--manifest-path",
      "verification/generic-harness/Cargo.toml"
    ]
  ],
  "extractions": [
    {
      "config": "extraction.json",
      "cwd": "verification/generic-harness",
      "models": {
        "GenericPartial.lean": "proofs/Generated/@TARGET@/GenericPartial.lean"
      }
    }
  ],
  "inventory": "theorems.json",
  "report": "proofs.toml",
  "lean_dir": "proofs",
  "additional_checks": [
    [
      "python3.11",
      "scripts/check-execution-config.py"
    ],
    [
      "python3.11",
      "verification/generic-harness/check-adaptation.py"
    ]
  ],
  "post_checks": [
    [
      "python3.11",
      "scripts/check-execution-config.py"
    ],
    [
      "python3.11",
      "verification/generic-harness/check-adaptation.py"
    ]
  ]
}
