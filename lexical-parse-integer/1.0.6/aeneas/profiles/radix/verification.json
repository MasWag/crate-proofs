{
  "schema_version": 1,
  "supported_targets": ["aarch64-apple-darwin"],
  "native": [
    ["cargo", "test", "--locked"],
    ["cargo", "test", "--locked", "--manifest-path", "verification/radix-harness/Cargo.toml"]
  ],
  "extractions": [
    {
      "config": "extraction.json",
      "cwd": "verification/radix-harness",
