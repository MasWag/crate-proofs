        "LexicalParseIntegerRadix.lean": "proofs/Generated/@TARGET@/LexicalParseIntegerRadix.lean"
      }
    }
  ],
  "inventory": "theorems.json",
  "report": "proofs.toml",
  "lean_dir": "proofs",
  "additional_checks": [
    ["python3.11", "scripts/check-execution-config.py"],
    ["python3.11", "scripts/check-radix-adaptation.py"]
  ],
  "post_checks": [
    ["python3.11", "scripts/check-execution-config.py"],
    ["python3.11", "scripts/check-radix-adaptation.py"]
  ]
}
