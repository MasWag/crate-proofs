{
  "schema_version": 1,
  "supported_targets": ["aarch64-apple-darwin"],
  "native": [
    ["cargo", "test", "--locked", "--offline", "--manifest-path", "verification/sign-harness/Cargo.toml"]
  ],
  "extractions": [
    {
      "config": "extraction.json",
      "cwd": ".",
      "models": {"Sign.lean": "proofs/Generated/@TARGET@/Sign.lean"}
    }
  ],
  "inventory": "theorems.json",
  "report": "proofs.toml",
  "lean_dir": "proofs",
  "additional_checks": [
    ["python3.11", "scripts/check-execution-config.py"],
    ["python3.11", "scripts/check-sign-adaptation.py"],
    ["python3.11", "verification/sign-harness/check-dependency.py"]
  ],
  "post_checks": [
    ["python3.11", "scripts/check-execution-config.py"],
    ["python3.11", "scripts/check-sign-adaptation.py"],
    ["python3.11", "verification/sign-harness/check-dependency.py"]
  ]
}
