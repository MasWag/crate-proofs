{
  "schema_version": 1,
  "supported_targets": [
    "aarch64-apple-darwin"
  ],
  "native": [
    [
      "cargo",
      "test",
      "--locked"
    ],
    [
      "cargo",
      "test",
      "--locked",
      "--manifest-path",
      "verification/harness/Cargo.toml"
    ]
  ],
  "extractions": [
    {
      "config": "extraction.json",
      "cwd": "verification/harness",
      "models": {
        "LexicalParseInteger.lean": "proofs/Generated/@TARGET@/LexicalParseInteger.lean"
      }
    }
  ],
  "inventory": "theorems.json",
  "report": "proofs.toml",
  "lean_dir": "proofs",
  "additional_checks": [
    ["python3.11", "scripts/check-execution-config.py"],
    ["python3.11", "scripts/check-swar-adaptation.py"],
    ["python3.11", "scripts/check-original-parser-blocker.py"]
  ],
  "post_checks": [
    ["python3.11", "scripts/check-execution-config.py"],
    ["python3.11", "scripts/check-swar-adaptation.py"]
  ]
}
