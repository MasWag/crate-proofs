+// Syn deliberately parses modern Rust only. In Rust 2015 trait declarations,
+// anonymous parameters are legal. Normalize only their declaration tokens for
+// discovery; retain original spans and never rewrite the source being verified.
+fn legacy_trait_parameters(tokens: proc_macro2::TokenStream, in_trait: bool) -> syn::Result<proc_macro2::TokenStream> {
+    use proc_macro2::{Delimiter, Group, TokenTree};
+    struct Arguments(proc_macro2::TokenStream);
+    impl syn::parse::Parse for Arguments {
+        fn parse(input: syn::parse::ParseStream) -> syn::Result<Self> {
+            let mut out = proc_macro2::TokenStream::new();
+            while !input.is_empty() {
+                let fork = input.fork();
+                if let Ok(arg) = fork.parse::<syn::FnArg>() {
+                    input.advance_to(&fork);
+                    arg.to_tokens(&mut out);
+                } else {
+                    let ty: syn::Type = input.parse()?;
+                    let span = ty.span();
+                    out.extend(quote::quote_spanned!(span=> _: #ty));
+                }
+                if !input.is_empty() {
+                    let comma: Token![,] = input.parse()?;
+                    comma.to_tokens(&mut out);
+                }
+            }
+            Ok(Self(out))
+        }
+    }
+    use syn::parse::discouraged::Speculative;
+    let mut out = proc_macro2::TokenStream::new();
+    let mut trait_pending = false;
+    let mut fn_pending = false;
+    let mut angles = 0usize;
+    for token in tokens {
+        match token {
+            TokenTree::Ident(ref ident) if ident == "trait" => trait_pending = true,
+            TokenTree::Ident(ref ident) if in_trait && ident == "fn" => fn_pending = true,
+            TokenTree::Punct(ref p) if fn_pending && p.as_char() == '<' => angles += 1,
+            TokenTree::Punct(ref p) if fn_pending && p.as_char() == '>' => angles = angles.saturating_sub(1),
+            TokenTree::Group(ref group) => {
+                let inner = if fn_pending && angles == 0 && group.delimiter() == Delimiter::Parenthesis {
+                    fn_pending = false;
+                    syn::parse2::<Arguments>(group.stream())?.0
+                } else if group.delimiter() == Delimiter::Brace {
+                    let is_trait = trait_pending;
+                    trait_pending = false;
+                    // Trait method bodies are ordinary Rust, not trait declarations.
+                    legacy_trait_parameters(group.stream(), is_trait)?
+                } else { group.stream() };
+                let mut replacement = Group::new(group.delimiter(), inner);
+                replacement.set_span(group.span());
+                out.extend([TokenTree::Group(replacement)]);
+                continue;
+            }
+            TokenTree::Punct(ref p) if p.as_char() == ';' => { trait_pending = false; fn_pending = false; }
+            _ => {}
+        }
+        out.extend([token]);
+    }
+    Ok(out)
+}
 
+fn rust_2015(project: &Project) -> bool {
+    let manifest = fs::read_to_string(&project.manifest).unwrap_or_default();
+    let package: toml::Value = toml::from_str(&manifest)
+        .unwrap_or_else(|_| toml::Value::Table(Default::default()));
+    let edition = package.get("package").and_then(|p| p.get("edition"));
+    edition.is_none() || edition.and_then(toml::Value::as_str) == Some("2015")
+}
