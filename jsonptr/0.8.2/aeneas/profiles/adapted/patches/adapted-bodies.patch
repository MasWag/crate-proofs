+/// Adapted `Pointer::split_front` (release `pointer.rs:181`).
+///
+/// Substitutions: the pointer and token are byte slices; `is_root` is
+/// `is_empty`; `str::find` is `find_slash_adapted`; `Self::root()` is an empty
+/// slice; the unchecked token and pointer constructors return the bytes.
+#[doc(hidden)]
+pub fn split_front_adapted(s: &[u8]) -> Option<(&[u8], &[u8])> {
+    if s.is_empty() {
+        return None;
+    }
+    let rest = &s[1..];
+    match find_slash_adapted(rest) {
+        None => Some((rest, &[])),
+        Some(idx) => {
+            let (front, back) = rest.split_at(idx);
+            Some((front, back))
+        }
+    }
+}
