+/// Local document type for the adapted resolution profile. It stands for the
+/// three node kinds that `Resolve for serde_json::Value` distinguishes; it is
+/// not `serde_json::Value`.
+#[doc(hidden)]
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum DocAdapted {
+    /// A scalar node (null, boolean, number or string in JSON).
+    Leaf(u64),
+    /// An array: a sequence of children.
+    Array(alloc::vec::Vec<DocAdapted>),
+    /// An object: decoded key bytes and children; the first matching key wins.
+    Object(alloc::vec::Vec<(alloc::vec::Vec<u8>, DocAdapted)>),
+}
+
+/// `resolve::Error` with `ParseIndexError` replaced by its adapted mirror.
+#[doc(hidden)]
+#[derive(Debug, PartialEq, Eq)]
+pub enum ResolveErrorAdapted {
+    /// `Error::FailedToParseIndex`
+    FailedToParseIndex {
+        /// position
+        position: usize,
+        /// offset
+        offset: usize,
+        /// source
+        source: crate::index::ParseIndexErrorAdapted,
+    },
+    /// `Error::OutOfBounds`
+    OutOfBounds {
+        /// position
+        position: usize,
+        /// offset
+        offset: usize,
+        /// source
+        source: OutOfBoundsError,
+    },
+    /// `Error::NotFound`
+    NotFound {
+        /// position
+        position: usize,
+        /// offset
+        offset: usize,
+    },
+    /// `Error::Unreachable`
+    Unreachable {
+        /// position
+        position: usize,
+        /// offset
+        offset: usize,
+    },
+}
+
+/// Exact byte equality, as an explicit loop.
+#[doc(hidden)]
+pub fn bytes_eq_adapted(a: &[u8], b: &[u8]) -> bool {
+    if a.len() != b.len() {
+        return false;
+    }
+    let mut i = 0;
+    while i < a.len() {
+        if a[i] != b[i] {
+            return false;
+        }
+        i += 1;
+    }
+    true
+}
+
+/// First-match lookup of a decoded key in an object of the local document type.
+/// This stands in for `serde_json::Map::get`; it is not release code.
+#[doc(hidden)]
+pub fn lookup_adapted<'d>(members: &'d [(alloc::vec::Vec<u8>, DocAdapted)], key: &[u8]) -> Option<&'d DocAdapted> {
+    let mut i = 0;
+    while i < members.len() {
+        if bytes_eq_adapted(&members[i].0, key) {
+            return Some(&members[i].1);
+        }
+        i += 1;
+    }
+    None
+}
+
+/// One iteration of the adapted resolution loop: the release block
+/// `value = match value { .. }?` at `resolve.rs:290-313`, for one encoded
+/// token `tok` at the given `position` and `offset`. (The parameter is not
+/// named `token` so that the generated Lean binder does not shadow the
+/// generated `token` namespace.)
+///
+/// Substitutions: `token.to_index()` is `from_str_adapted` on the encoded
+/// token; the `map_err` closures and `?` are `match` with early return;
+/// `Map::get` on the decoded key is `lookup_adapted` on the bytes returned by
+/// `decoded_adapted`, or on the token itself when no decoding was needed. The
+/// release `Index::for_len` and the indexing `&v[idx]` are unchanged.
+#[doc(hidden)]
+pub fn resolve_step_adapted<'d>(
+    value: &'d DocAdapted,
+    tok: &[u8],
+    position: usize,
+    offset: usize,
+) -> Result<&'d DocAdapted, ResolveErrorAdapted> {
+    match value {
+        DocAdapted::Array(v) => {
+            let idx = match crate::index::from_str_adapted(tok) {
+                Err(source) => {
+                    return Err(ResolveErrorAdapted::FailedToParseIndex {
+                        position,
+                        offset,
+                        source,
+                    })
+                }
+                Ok(idx) => idx,
+            };
+            let idx = match idx.for_len(v.len()) {
+                Err(source) => {
+                    return Err(ResolveErrorAdapted::OutOfBounds {
+                        position,
+                        offset,
+                        source,
+                    })
+                }
+                Ok(idx) => idx,
+            };
+            Ok(&v[idx])
+        }
+        DocAdapted::Object(v) => {
+            let found = match crate::token::decoded_adapted(tok) {
+                Some(bytes) => lookup_adapted(v, &bytes),
+                None => lookup_adapted(v, tok),
+            };
+            match found {
+                Some(child) => Ok(child),
+                None => Err(ResolveErrorAdapted::NotFound { position, offset }),
+            }
+        }
+        DocAdapted::Leaf(_) => Err(ResolveErrorAdapted::Unreachable { position, offset }),
+    }
+}
+
+/// Tail-recursive form of the adapted resolution loop, approved for the Aeneas
+/// profile because the loop in `resolve_adapted` does not extract. One call is
+/// one iteration of the release loop at `resolve.rs:287-317`: split the front
+/// token, run `resolve_step_adapted` with the current `position` and `offset`,
+/// return early on its error, then continue with the remainder at
+/// `position + 1` and `offset + (1 + tok_len)`, the same machine operations in
+/// the same order as `offset += 1 + tok_len; position += 1`. Recursion replaces
+/// the loop; its stack depth grows with the token count.
+#[doc(hidden)]
+pub fn resolve_rec_adapted<'d>(
+    value: &'d DocAdapted,
+    ptr: &[u8],
+    position: usize,
+    offset: usize,
+) -> Result<&'d DocAdapted, ResolveErrorAdapted> {
+    match crate::pointer::split_front_adapted(ptr) {
+        None => Ok(value),
+        Some((tok, rem)) => {
+            let tok_len = tok.len();
+            let child = match resolve_step_adapted(value, tok, position, offset) {
+                Ok(child) => child,
+                Err(err) => return Err(err),
+            };
+            let next_offset = offset + (1 + tok_len);
+            let next_position = position + 1;
+            resolve_rec_adapted(child, rem, next_position, next_offset)
+        }
+    }
+}
+
+/// Adapted `Resolve::resolve` for JSON in recursive form: starts the recursion
+/// at the document root with `position = 0` and `offset = 0`.
+#[doc(hidden)]
+pub fn resolve_recursive_adapted<'d>(doc: &'d DocAdapted, ptr: &[u8]) -> Result<&'d DocAdapted, ResolveErrorAdapted> {
+    resolve_rec_adapted(doc, ptr, 0, 0)
+}
+
+/// Adapted `Resolve::resolve` for JSON (release `resolve.rs:283`), run over the
+/// local document type. The loop, `split_front`, the `offset`/`position`
+/// updates and their machine arithmetic follow the release; the loop body is
+/// `resolve_step_adapted`. `&Pointer` is a byte slice and `split_front` is
+/// `split_front_adapted`; `token.encoded().len()` is the token length.
+#[doc(hidden)]
+pub fn resolve_adapted<'d>(doc: &'d DocAdapted, ptr: &[u8]) -> Result<&'d DocAdapted, ResolveErrorAdapted> {
+    let mut ptr = ptr;
+    let mut offset = 0;
+    let mut position = 0;
+    let mut value = doc;
+    while let Some((token, rem)) = crate::pointer::split_front_adapted(ptr) {
+        let tok_len = token.len();
+        ptr = rem;
+        value = match resolve_step_adapted(value, token, position, offset) {
+            Ok(child) => child,
+            Err(err) => return Err(err),
+        };
+        offset += 1 + tok_len;
+        position += 1;
+    }
+    Ok(value)
+}
