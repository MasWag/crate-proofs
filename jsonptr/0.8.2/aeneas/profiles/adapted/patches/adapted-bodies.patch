+/// Adapted `bytes().position(|b| b == b'/' || b == b'~')` used by `Token::new`.
+#[doc(hidden)]
+pub fn position_slash_or_tilde_adapted(s: &[u8]) -> Option<usize> {
+    let mut i = 0;
+    while i < s.len() {
+        let b = s[i];
+        if b == b'/' || b == b'~' {
+            return Some(i);
+        }
+        i += 1;
+    }
+    None
+}
+
+/// Adapted `Token::new` (release `token.rs:128`) for the Aeneas profile.
+///
+/// Returns `None` where the release keeps the caller's `Cow`, and the new
+/// buffer where it builds `Cow::Owned`. Substitutions: byte slices for `str`;
+/// explicit index loops for `position` and for the `for` loop over
+/// `&input[i..]`; two pushes for each two-byte escape constant; the returned
+/// bytes for `String::from_utf8_unchecked`. The capacity and the prefix copy
+/// `extend_from_slice(&input[..i])` are unchanged.
+#[doc(hidden)]
+pub fn new_adapted(s: &[u8]) -> Option<Vec<u8>> {
+    if let Some(i) = position_slash_or_tilde_adapted(s) {
+        let input = s;
+        let mut bytes = Vec::with_capacity(input.len() + 1);
+        bytes.extend_from_slice(&input[..i]);
+        let mut k = i;
+        while k < input.len() {
+            let b = input[k];
+            match b {
+                b'/' => {
+                    bytes.push(b'~');
+                    bytes.push(b'1');
+                }
+                b'~' => {
+                    bytes.push(b'~');
+                    bytes.push(b'0');
+                }
+                other => {
+                    bytes.push(other);
+                }
+            }
+            k += 1;
+        }
+        Some(bytes)
+    } else {
+        None
+    }
+}
+
+/// Adapted `bytes().position(|b| b == ENC_PREFIX)` used by `Token::decoded`.
+#[doc(hidden)]
+pub fn position_tilde_adapted(s: &[u8]) -> Option<usize> {
+    let mut i = 0;
+    while i < s.len() {
+        if s[i] == ENC_PREFIX {
+            return Some(i);
+        }
+        i += 1;
+    }
+    None
+}
