+/// The validation loop of `Token::from_encoded` (release `token.rs:79-109`):
+/// `bytes().enumerate()` is an explicit index loop with the same order, early
+/// exits and final pending-tilde check. It returns `()` where the release
+/// returns `Ok(Self { inner })`; `from_encoded_adapted` returns the input.
+#[doc(hidden)]
+pub fn from_encoded_scan_adapted(inner: &[u8]) -> Result<(), EncodingError> {
+    let mut escaped = false;
+    let mut offset = 0;
+    while offset < inner.len() {
+        let b = inner[offset];
+        match b {
+            b'/' => {
+                return Err(EncodingError {
+                    offset,
+                    source: InvalidEncoding::Slash,
+                })
+            }
+            ENC_PREFIX if !escaped => {
+                escaped = true;
+            }
+            TILDE_ENC | SLASH_ENC if escaped => {
+                escaped = false;
+            }
+            _ => {
+                if escaped {
+                    return Err(EncodingError {
+                        offset,
+                        source: InvalidEncoding::Tilde,
+                    });
+                }
+            }
+        }
+        offset += 1;
+    }
+    if escaped {
+        return Err(EncodingError {
+            offset: inner.len(),
+            source: InvalidEncoding::Tilde,
+        });
+    }
+    Ok(())
+}
+
+/// Adapted `Token::from_encoded` (release `token.rs:77`) for the Aeneas profile.
+///
+/// Substitutions: `Into<Cow<str>>` is replaced by a byte slice; the loop is in
+/// `from_encoded_scan_adapted`. The success value is the unchanged input.
+#[doc(hidden)]
+pub fn from_encoded_adapted(inner: &[u8]) -> Result<&[u8], EncodingError> {
+    match from_encoded_scan_adapted(inner) {
+        Err(err) => Err(err),
+        Ok(()) => Ok(inner),
+    }
+}
