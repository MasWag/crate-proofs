+/// Adapted `str::find('/')` used by `Pointer::split_front`: the first index of
+/// `b'/'`, scanning from the front with an early exit.
+#[doc(hidden)]
+pub fn find_slash_adapted(s: &[u8]) -> Option<usize> {
+    let mut i = 0;
+    while i < s.len() {
