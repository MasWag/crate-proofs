+/// Adapted `Token::decoded` (release `token.rs:224`) for the Aeneas profile.
+///
+/// Returns `None` where the release clones the stored `Cow`, and the new
+/// buffer where it builds `Cow::Owned`. Substitutions as for `new_adapted`.
+#[doc(hidden)]
+pub fn decoded_adapted(inner: &[u8]) -> Option<Vec<u8>> {
+    if let Some(i) = position_tilde_adapted(inner) {
+        let input = inner;
+        let mut bytes = Vec::with_capacity(input.len() + 1);
+        bytes.extend_from_slice(&input[..i]);
+        let mut escaped = true;
+        let mut k = i + 1;
+        while k < input.len() {
+            let b = input[k];
+            match b {
+                ENC_PREFIX => {
+                    escaped = true;
+                }
+                TILDE_ENC if escaped => {
+                    bytes.push(b'~');
+                    escaped = false;
+                }
+                SLASH_ENC if escaped => {
+                    bytes.push(b'/');
+                    escaped = false;
+                }
+                other => {
+                    bytes.push(other);
+                }
+            }
+            k += 1;
+        }
+        Some(bytes)
+    } else {
+        None
+    }
+}
