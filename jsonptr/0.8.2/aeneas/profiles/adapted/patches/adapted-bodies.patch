+/// The two `IntErrorKind`s that `Index::from_str` can return, mirrored for the
+/// adapted profile because a `ParseIntError` cannot be built outside `core`.
+#[doc(hidden)]
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum IntErrorKindAdapted {
+    /// `IntErrorKind::Empty`
+    Empty,
+    /// `IntErrorKind::PosOverflow`
+    PosOverflow,
+}
+
+/// `ParseIndexError` with the `ParseIntError` replaced by its kind.
+#[doc(hidden)]
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ParseIndexErrorAdapted {
+    /// `ParseIndexError::InvalidInteger`
+    InvalidInteger(IntErrorKindAdapted),
+    /// `ParseIndexError::LeadingZeros`
+    LeadingZeros,
+    /// `ParseIndexError::InvalidCharacter`
+    InvalidCharacter(InvalidCharacterError),
+}
+
+/// Adapted `chars().position(|c| !c.is_ascii_digit())`, counting bytes. The
+/// two counts agree because every earlier byte is an ASCII digit.
+#[doc(hidden)]
+pub fn position_non_digit_adapted(s: &[u8]) -> Option<usize> {
+    let mut i = 0;
+    while i < s.len() {
+        if !s[i].is_ascii_digit() {
+            return Some(i);
+        }
+        i += 1;
+    }
+    None
+}
+
+/// Standard-library substitution for `s.parse::<usize>()` on input whose
+/// bytes are all ASCII digits: checked decimal accumulation, most significant
+/// digit first, reporting the `Empty` and `PosOverflow` kinds.
+#[doc(hidden)]
+pub fn parse_usize_digits_adapted(s: &[u8]) -> Result<usize, IntErrorKindAdapted> {
+    if s.is_empty() {
+        return Err(IntErrorKindAdapted::Empty);
+    }
+    let mut acc: usize = 0;
+    let mut i = 0;
+    while i < s.len() {
+        let d = (s[i] - b'0') as usize;
+        match acc.checked_mul(10) {
+            None => return Err(IntErrorKindAdapted::PosOverflow),
+            Some(m) => match m.checked_add(d) {
+                None => return Err(IntErrorKindAdapted::PosOverflow),
+                Some(a) => acc = a,
+            },
+        }
+        i += 1;
+    }
+    Ok(acc)
+}
+
+/// Adapted `<Index as FromStr>::from_str` (release `index.rs:166`).
+///
+/// Substitutions: byte slice for `&str`; `s == "-"`, `starts_with('0')` and
+/// `s != "0"` by length and byte tests; `chars().position` by
+/// `position_non_digit_adapted`; `map_or_else` closures by a `match`;
+/// `s.parse::<usize>()` by `parse_usize_digits_adapted`; `ParseIndexError` by
+/// `ParseIndexErrorAdapted`.
+#[doc(hidden)]
+pub fn from_str_adapted(s: &[u8]) -> Result<Index, ParseIndexErrorAdapted> {
+    if s.len() == 1 && s[0] == b'-' {
+        Ok(Index::Next)
+    } else if (!s.is_empty() && s[0] == b'0') && !(s.len() == 1 && s[0] == b'0') {
+        Err(ParseIndexErrorAdapted::LeadingZeros)
+    } else {
+        match position_non_digit_adapted(s) {
+            None => match parse_usize_digits_adapted(s) {
+                Ok(n) => Ok(Index::Num(n)),
+                Err(kind) => Err(ParseIndexErrorAdapted::InvalidInteger(kind)),
+            },
+            Some(offset) => Err(ParseIndexErrorAdapted::InvalidCharacter(
+                InvalidCharacterError { offset },
+            )),
+        }
+    }
+}
