+/* ----------------------------------------------------------------------- *
+ *  Section 9: range indexing.                                             *
+ * ----------------------------------------------------------------------- */
+
+/// `PointerIndex::get` for `Range<usize>` (release `pointer/slice.rs:22`).
+/// Substitutions: the `for` loop over `tokens()` is a `loop` over
+/// `tokens_next_adapted` that reads the token's length (the only use of the
+/// token) when it is yielded; `?` on the two offsets is a `match` with early
+/// return, start first; the unchecked UTF-8 and pointer constructors return
+/// the byte slice. The machine `idx += 1` and `offset += len + 1` are kept.
+pub fn get_range_adapted(ptr: &[u8], start: usize, end: usize) -> Option<&[u8]> {
+    if end < start {
+        return None;
+    }
+    let mut idx: usize = 0;
+    let mut offset: usize = 0;
+    let mut start_offset: Option<usize> = None;
+    let mut end_offset: Option<usize> = None;
+    let mut it = tokens_adapted(ptr);
+    loop {
+        let token_len = match tokens_next_adapted(&mut it) {
+            None => break,
+            Some(token) => token.len(),
+        };
+        if idx == start {
+            start_offset = Some(offset);
+        }
+        if idx == end {
+            end_offset = Some(offset);
+            break;
+        }
+        idx += 1;
+        offset += token_len + 1;
+    }
+    if idx == end {
+        end_offset = Some(offset);
+    }
+    let s = match start_offset {
+        None => return None,
+        Some(s) => s,
+    };
+    let e = match end_offset {
+        None => return None,
+        Some(e) => e,
+    };
+    Some(&ptr[s..e])
+}
+
+/// `PointerIndex::get` for `RangeFrom<usize>` (release `pointer/slice.rs:62`).
+/// `enumerate()` is an explicit counter incremented when an item is yielded.
+pub fn get_range_from_adapted(ptr: &[u8], start: usize) -> Option<&[u8]> {
+    let mut offset: usize = 0;
+    let mut start_offset: Option<usize> = None;
+    let mut count: usize = 0;
+    let mut it = tokens_adapted(ptr);
+    loop {
+        let token_len = match tokens_next_adapted(&mut it) {
+            None => break,
+            Some(token) => token.len(),
+        };
+        let idx = count;
+        count += 1;
+        if idx == start {
+            start_offset = Some(offset);
+            break;
+        }
+        offset += token_len + 1;
+    }
+    let s = match start_offset {
+        None => return None,
+        Some(s) => s,
+    };
+    Some(&ptr[s..])
+}
+
+/// `PointerIndex::get` for `RangeTo<usize>` (release `pointer/slice.rs:87`).
+pub fn get_range_to_adapted(ptr: &[u8], end: usize) -> Option<&[u8]> {
+    let mut idx: usize = 0;
+    let mut offset: usize = 0;
+    let mut end_offset: Option<usize> = None;
+    let mut it = tokens_adapted(ptr);
+    loop {
+        let token_len = match tokens_next_adapted(&mut it) {
+            None => break,
+            Some(token) => token.len(),
+        };
+        if idx == end {
+            end_offset = Some(offset);
+            break;
+        }
+        idx += 1;
+        offset += token_len + 1;
+    }
+    if idx == end {
+        end_offset = Some(offset);
+    }
+    let e = match end_offset {
+        None => return None,
+        Some(e) => e,
+    };
+    Some(&ptr[..e])
+}
+
+/// `PointerIndex::get` for `RangeInclusive<usize>` (release
+/// `pointer/slice.rs:128`). `into_inner` is the two parameters; it ignores the
+/// `exhausted` flag in the release too.
+pub fn get_range_inclusive_adapted(ptr: &[u8], start: usize, end: usize) -> Option<&[u8]> {
+    if end < start {
+        return None;
+    }
+    let mut offset: usize = 0;
+    let mut start_offset: Option<usize> = None;
+    let mut end_offset: Option<usize> = None;
+    let mut count: usize = 0;
+    let mut it = tokens_adapted(ptr);
+    loop {
+        let token_len = match tokens_next_adapted(&mut it) {
+            None => break,
+            Some(token) => token.len(),
+        };
+        let idx = count;
+        count += 1;
+        if idx == start {
+            start_offset = Some(offset);
+        }
+        offset += token_len + 1;
+        if idx == end {
+            end_offset = Some(offset);
+            break;
+        }
+    }
+    let s = match start_offset {
+        None => return None,
+        Some(s) => s,
+    };
+    let e = match end_offset {
+        None => return None,
+        Some(e) => e,
+    };
+    Some(&ptr[s..e])
+}
+
+/// `PointerIndex::get` for `RangeToInclusive<usize>` (release
+/// `pointer/slice.rs:166`).
+pub fn get_range_to_inclusive_adapted(ptr: &[u8], end: usize) -> Option<&[u8]> {
+    let mut offset: usize = 0;
+    let mut end_offset: Option<usize> = None;
+    let mut count: usize = 0;
+    let mut it = tokens_adapted(ptr);
+    loop {
+        let token_len = match tokens_next_adapted(&mut it) {
+            None => break,
+            Some(token) => token.len(),
+        };
+        let idx = count;
+        count += 1;
+        offset += token_len + 1;
+        if idx == end {
+            end_offset = Some(offset);
+            break;
+        }
+    }
+    let e = match end_offset {
+        None => return None,
+        Some(e) => e,
+    };
+    Some(&ptr[..e])
+}
+
+/// `PointerIndex::get` for `RangeFull` (release `pointer/slice.rs:120`).
+pub fn get_range_full_adapted(ptr: &[u8]) -> Option<&[u8]> {
+    Some(ptr)
+}
+
+/// `core::ops::Bound<usize>`, mirrored one for one.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum BoundAdapted {
+    Included(usize),
+    Excluded(usize),
+    Unbounded,
+}
+
+/// `PointerIndex::get` for `(Bound<usize>, Bound<usize>)` (release
+/// `pointer/slice.rs:196`). The machine `start + 1` is kept (JSONPTR-002).
+pub fn get_bounds_adapted(ptr: &[u8], start: BoundAdapted, end: BoundAdapted) -> Option<&[u8]> {
+    match (start, end) {
+        (BoundAdapted::Included(s), BoundAdapted::Included(e)) => get_range_inclusive_adapted(ptr, s, e),
+        (BoundAdapted::Included(s), BoundAdapted::Excluded(e)) => get_range_adapted(ptr, s, e),
+        (BoundAdapted::Included(s), BoundAdapted::Unbounded) => get_range_from_adapted(ptr, s),
+        (BoundAdapted::Excluded(s), BoundAdapted::Included(e)) => get_range_inclusive_adapted(ptr, s + 1, e),
+        (BoundAdapted::Excluded(s), BoundAdapted::Excluded(e)) => get_range_adapted(ptr, s + 1, e),
+        (BoundAdapted::Excluded(s), BoundAdapted::Unbounded) => get_range_from_adapted(ptr, s + 1),
+        (BoundAdapted::Unbounded, BoundAdapted::Included(e)) => get_range_to_inclusive_adapted(ptr, e),
+        (BoundAdapted::Unbounded, BoundAdapted::Excluded(e)) => get_range_to_adapted(ptr, e),
+        (BoundAdapted::Unbounded, BoundAdapted::Unbounded) => get_range_full_adapted(ptr),
+    }
+}
