+
+#[cfg(feature = "resolve")]
+pub use doc_mut::*;
+
+#[cfg(feature = "resolve")]
+mod doc_mut {
+    use super::{copy_bytes_ext, split_back_adapted};
+    use crate::index::{from_str_adapted, OutOfBoundsError, ParseIndexErrorAdapted};
+    use crate::pointer::split_front_adapted;
+    use crate::resolve::{bytes_eq_adapted, DocAdapted, ResolveErrorAdapted};
+    use crate::token::decoded_adapted;
+    use alloc::vec::Vec;
+
+    /// First index of a member whose key equals `key` (local stand-in for the
+    /// key search of `Map::get_mut` / `Map::entry` / `Map::remove`; not
+    /// release code).
+    pub fn find_key_adapted(members: &[(Vec<u8>, DocAdapted)], key: &[u8]) -> Option<usize> {
+        let mut i = 0;
+        while i < members.len() {
+            if bytes_eq_adapted(&members[i].0, key) {
+                return Some(i);
+            }
+            i += 1;
+        }
+        None
+    }
+
+    /// `token.decoded()` as owned bytes (`Token::to_string` writes the
+    /// decoded text, so this is also the `to_string` key of `assign`).
+    pub fn decoded_key_adapted(tok: &[u8]) -> Vec<u8> {
+        match decoded_adapted(tok) {
+            Some(v) => v,
+            None => copy_bytes_ext(tok),
+        }
+    }
+
+    /// One iteration of the `ResolveMut for serde_json::Value` loop
+    /// (release `resolve.rs:331-343`), over the local document type: the
+    /// array arm is `parse_index` (`to_index` then `for_len`) and `&mut
+    /// array[idx]`; the object arm is `get_mut` on the decoded key.
+    pub fn resolve_mut_step_adapted<'d>(
+        value: &'d mut DocAdapted,
+        tok: &[u8],
+        position: usize,
+        offset: usize,
+    ) -> Result<&'d mut DocAdapted, ResolveErrorAdapted> {
+        match value {
+            DocAdapted::Array(v) => {
+                let idx = match from_str_adapted(tok) {
+                    Err(source) => {
+                        return Err(ResolveErrorAdapted::FailedToParseIndex { position, offset, source })
+                    }
+                    Ok(idx) => idx,
+                };
+                let idx = match idx.for_len(v.len()) {
+                    Err(source) => return Err(ResolveErrorAdapted::OutOfBounds { position, offset, source }),
+                    Ok(idx) => idx,
+                };
+                Ok(&mut v[idx])
+            }
+            DocAdapted::Object(v) => {
+                let key = decoded_key_adapted(tok);
+                match find_key_adapted(v, &key) {
+                    Some(i) => Ok(&mut v[i].1),
+                    None => Err(ResolveErrorAdapted::NotFound { position, offset }),
+                }
+            }
+            DocAdapted::Leaf(_) => Err(ResolveErrorAdapted::Unreachable { position, offset }),
+        }
+    }
+
+    /// Tail-recursive form of the `ResolveMut` loop (release
+    /// `resolve.rs:325-346`), as approved for target 7: split the front
+    /// token, run the step, return early on error, continue at
+    /// `position + 1` and `offset + (1 + tok_len)`. Stack depth grows with
+    /// the token count.
+    pub fn resolve_mut_rec_adapted<'d>(
+        value: &'d mut DocAdapted,
+        ptr: &[u8],
+        position: usize,
+        offset: usize,
+    ) -> Result<&'d mut DocAdapted, ResolveErrorAdapted> {
+        match split_front_adapted(ptr) {
+            None => Ok(value),
+            Some((tok, rem)) => {
+                let tok_len = tok.len();
+                let child = match resolve_mut_step_adapted(value, tok, position, offset) {
+                    Ok(child) => child,
+                    Err(err) => return Err(err),
+                };
+                let next_offset = offset + (1 + tok_len);
+                let next_position = position + 1;
+                resolve_mut_rec_adapted(child, rem, next_position, next_offset)
+            }
+        }
+    }
+
+    /// Adapted `ResolveMut::resolve_mut` for JSON (release `resolve.rs:325`).
+    pub fn resolve_mut_adapted<'d>(doc: &'d mut DocAdapted, ptr: &[u8]) -> Result<&'d mut DocAdapted, ResolveErrorAdapted> {
+        resolve_mut_rec_adapted(doc, ptr, 0, 0)
+    }
+
+    /// `assign::Error` with `ParseIndexError` replaced by its adapted mirror.
+    #[derive(Debug, PartialEq, Eq)]
+    pub enum AssignErrorAdapted {
+        FailedToParseIndex { position: usize, offset: usize, source: ParseIndexErrorAdapted },
+        OutOfBounds { position: usize, offset: usize, source: OutOfBoundsError },
+    }
+
+    /// `expand` (release `assign.rs:276`): wrap the value once per remaining
+    /// token, from the back. Encoded `"0"`/`"-"` make a one-item array; any
+    /// other token a one-member object keyed by `tok.to_string()` (the decoded
+    /// key). `vec![value]` is `Vec::new` plus `push`; `Map::insert` into a new
+    /// map is a one-member vector. The `while let` over `split_back` is a
+    /// tail recursion on the remaining prefix.
+    pub fn expand_adapted(remaining: &[u8], value: DocAdapted) -> DocAdapted {
+        match split_back_adapted(remaining) {
+            None => value,
+            Some((ptr, tok)) => {
+                let wrapped = if (tok.len() == 1 && tok[0] == b'0') || (tok.len() == 1 && tok[0] == b'-') {
+                    let mut v = Vec::new();
+                    v.push(value);
+                    DocAdapted::Array(v)
+                } else {
+                    let mut obj = Vec::new();
+                    obj.push((decoded_key_adapted(tok), value));
+                    DocAdapted::Object(obj)
+                };
+                expand_adapted(ptr, wrapped)
+            }
+        }
+    }
+
+    /// Tail-recursive form of `assign_value` (release `assign.rs:301-339`)
+    /// with `assign_array`, `assign_object`, `assign_scalar` inlined
+    /// (`assign.rs:341-428`). `Assigned::Continue` is the recursive call with
+    /// `position + 1` and `offset + (1 + tok_len)`; `Assigned::Done` returns.
+    /// `Map::entry(token.to_string())` is a key search on the decoded key;
+    /// a vacant entry is pushed at the end (the model's member order).
+    pub fn assign_rec_adapted(
+        dest: &mut DocAdapted,
+        ptr: &[u8],
+        value: DocAdapted,
+        position: usize,
+        offset: usize,
+    ) -> Result<Option<DocAdapted>, AssignErrorAdapted> {
+        match split_front_adapted(ptr) {
+            None => Ok(Some(core::mem::replace(dest, value))),
+            Some((tok, tail)) => {
+                let tok_len = tok.len();
+                match dest {
+                    DocAdapted::Array(array) => {
+                        let idx = match from_str_adapted(tok) {
+                            Err(source) => {
+                                return Err(AssignErrorAdapted::FailedToParseIndex { position, offset, source })
+                            }
+                            Ok(idx) => idx,
+                        };
+                        let idx = match idx.for_len_incl(array.len()) {
+                            Err(source) => return Err(AssignErrorAdapted::OutOfBounds { position, offset, source }),
+                            Ok(idx) => idx,
+                        };
+                        if idx < array.len() {
+                            if tail.is_empty() {
+                                Ok(Some(core::mem::replace(&mut array[idx], value)))
+                            } else {
+                                let next_offset = offset + (1 + tok_len);
+                                let next_position = position + 1;
+                                assign_rec_adapted(&mut array[idx], tail, value, next_position, next_offset)
+                            }
+                        } else {
+                            let src = expand_adapted(tail, value);
+                            array.push(src);
+                            Ok(None)
+                        }
+                    }
+                    DocAdapted::Object(obj) => {
+                        let key = decoded_key_adapted(tok);
+                        match find_key_adapted(obj, &key) {
+                            Some(i) => {
+                                if tail.is_empty() {
+                                    Ok(Some(core::mem::replace(&mut obj[i].1, value)))
+                                } else {
+                                    let next_offset = offset + (1 + tok_len);
+                                    let next_position = position + 1;
+                                    assign_rec_adapted(&mut obj[i].1, tail, value, next_position, next_offset)
+                                }
+                            }
+                            None => {
+                                let src = expand_adapted(tail, value);
+                                obj.push((key, src));
+                                Ok(None)
+                            }
+                        }
+                    }
+                    DocAdapted::Leaf(_) => {
+                        let e = expand_adapted(ptr, value);
+                        Ok(Some(core::mem::replace(dest, e)))
+                    }
+                }
+            }
+        }
+    }
+
+    /// Adapted `Assign::assign` for JSON (release `assign.rs:291`).
+    pub fn assign_adapted(doc: &mut DocAdapted, ptr: &[u8], value: DocAdapted) -> Result<Option<DocAdapted>, AssignErrorAdapted> {
+        assign_rec_adapted(doc, ptr, value, 0, 0)
+    }
+
+    /// `Vec::remove(idx)` (unmodelled by Aeneas) as a rebuild that moves each
+    /// item out with a placeholder and skips `idx`; order is kept.
+    pub fn remove_at_adapted(items: &mut Vec<DocAdapted>, idx: usize) -> DocAdapted {
+        let mut nb = Vec::new();
+        let mut removed = DocAdapted::Leaf(0);
+        let mut j = 0;
+        while j < items.len() {
+            let x = core::mem::replace(&mut items[j], DocAdapted::Leaf(0));
+            if j == idx {
+                removed = x;
+            } else {
+                nb.push(x);
+            }
+            j += 1;
+        }
+        *items = nb;
+        removed
+    }
+
+    /// `Map::remove(key)` on the local member list (first match), as a
+    /// rebuild like `remove_at_adapted`.
+    pub fn remove_member_adapted(members: &mut Vec<(Vec<u8>, DocAdapted)>, idx: usize) -> DocAdapted {
+        let mut nb = Vec::new();
+        let mut removed = DocAdapted::Leaf(0);
+        let mut j = 0;
+        while j < members.len() {
+            let x = core::mem::replace(&mut members[j].1, DocAdapted::Leaf(0));
+            let k = copy_bytes_ext(&members[j].0);
+            if j == idx {
+                removed = x;
+            } else {
+                nb.push((k, x));
+            }
+            j += 1;
+        }
+        *members = nb;
+        removed
+    }
+
+    /// `Delete::delete` (release `delete.rs:98` JSON, `:136` TOML) with the
+    /// root replacement as a parameter: JSON passes `Value::Null`
+    /// (`Leaf(0)`), TOML an empty table (`Object([])`). This is the one
+    /// difference between the two release spans.
+    pub fn delete_with_adapted(doc: &mut DocAdapted, ptr: &[u8], root_repl: DocAdapted) -> Option<DocAdapted> {
+        let (parent_ptr, last) = match split_back_adapted(ptr) {
+            None => return Some(core::mem::replace(doc, root_repl)),
+            Some(p) => p,
+        };
+        let parent = match resolve_mut_adapted(doc, parent_ptr) {
+            Err(_) => return None,
+            Ok(p) => p,
+        };
+        match parent {
+            DocAdapted::Array(children) => {
+                let idx = match from_str_adapted(last) {
+                    Err(_) => return None,
+                    Ok(i) => i,
+                };
+                let idx = match idx.for_len(children.len()) {
+                    Err(_) => return None,
+                    Ok(i) => i,
+                };
+                Some(remove_at_adapted(children, idx))
+            }
+            DocAdapted::Object(children) => {
+                let key = decoded_key_adapted(last);
+                match find_key_adapted(children, &key) {
+                    None => None,
+                    Some(i) => Some(remove_member_adapted(children, i)),
+                }
+            }
+            DocAdapted::Leaf(_) => None,
+        }
+    }
+
+    /// `Delete for serde_json::Value`: root replacement `Value::Null`.
+    pub fn delete_json_adapted(doc: &mut DocAdapted, ptr: &[u8]) -> Option<DocAdapted> {
+        delete_with_adapted(doc, ptr, DocAdapted::Leaf(0))
+    }
+
+    /// `assign::Error::position` (release `assign.rs:163`).
+    pub fn assign_error_position_adapted(e: &AssignErrorAdapted) -> usize {
+        match e {
+            AssignErrorAdapted::OutOfBounds { position, .. } | AssignErrorAdapted::FailedToParseIndex { position, .. } => *position,
+        }
+    }
+
+    /// `assign::Error::offset` (release `assign.rs:171`).
+    pub fn assign_error_offset_adapted(e: &AssignErrorAdapted) -> usize {
+        match e {
+            AssignErrorAdapted::OutOfBounds { offset, .. } | AssignErrorAdapted::FailedToParseIndex { offset, .. } => *offset,
+        }
+    }
+
+    /// `assign::Error::is_out_of_bounds` (release `assign.rs:181`).
+    pub fn assign_error_is_out_of_bounds_adapted(e: &AssignErrorAdapted) -> bool {
+        matches!(e, AssignErrorAdapted::OutOfBounds { .. })
+    }
+
+    /// `assign::Error::is_failed_to_parse_index` (release `assign.rs:189`).
+    pub fn assign_error_is_failed_to_parse_index_adapted(e: &AssignErrorAdapted) -> bool {
+        matches!(e, AssignErrorAdapted::FailedToParseIndex { .. })
+    }
+
+    /// `Diagnostic::labels` for `assign::Error` (release `assign.rs:218-236`),
+    /// as for `resolve::Error` (N6).
+    pub fn assign_error_label_adapted(e: &AssignErrorAdapted, origin: &[u8]) -> Option<super::SpanAdapted> {
+        let position = assign_error_position_adapted(e);
+        let token = match super::get_index_adapted(origin, position) {
+            None => return None,
+            Some(t) => t,
+        };
+        let offset = if assign_error_offset_adapted(e) + 1 < origin.len() {
+            assign_error_offset_adapted(e) + 1
+        } else {
+            assign_error_offset_adapted(e)
+        };
+        let len = token.len();
+        Some(super::SpanAdapted { offset, len })
+    }
+
+    /// `Delete for toml::Value`: root replacement an empty table.
+    pub fn delete_toml_adapted(doc: &mut DocAdapted, ptr: &[u8]) -> Option<DocAdapted> {
+        delete_with_adapted(doc, ptr, DocAdapted::Object(Vec::new()))
+    }
+}
