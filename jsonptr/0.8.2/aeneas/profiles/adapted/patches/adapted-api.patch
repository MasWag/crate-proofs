+//! Adapted byte-slice bodies for the extended scope (specification sections
+//! 8-21) of the Aeneas `adapted` profile. Not release API.
+//!
+//! Written by the implementation agent as an add-only extension layered after
+//! `adapted-bodies.patch`. Every function names the release span it rewrites
+//! and the substitutions it makes. Release items are not modified.
+#![allow(missing_docs, clippy::all, clippy::pedantic)]
+
+use alloc::vec::Vec;
+
+use crate::index::{from_str_adapted, Index};
+use crate::pointer::{find_slash_adapted, validate_adapted, ParseError, ReplaceError};
+use crate::token::{EncodingError, InvalidEncoding};
+
+/* ----------------------------------------------------------------------- *
+ *  Byte helpers standing for standard-library `str` / `[u8]` operations.  *
+ * ----------------------------------------------------------------------- */
+
+/// `str == str` / `[u8] == [u8]` (`SlicePartialEq`): length test, then a
+/// bytewise loop in index order with an early exit.
+pub fn bytes_eq_ext(a: &[u8], b: &[u8]) -> bool {
+    if a.len() != b.len() {
+        return false;
+    }
+    let mut i = 0;
+    while i < a.len() {
+        if a[i] != b[i] {
+            return false;
+        }
+        i += 1;
+    }
+    true
+}
+
+/// `str::rfind('/')` / the search of `str::rsplit_once('/')`: the last index
+/// of `b'/'`, scanning from the back with an early exit.
+pub fn rfind_slash_ext(s: &[u8]) -> Option<usize> {
+    let mut i = s.len();
+    while i > 0 {
+        i -= 1;
+        if s[i] == b'/' {
+            return Some(i);
+        }
+    }
+    None
+}
+
+/// `<&str as Pattern>::is_prefix_of` (`haystack.starts_with(needle)`):
+/// `h.len() >= n.len() && n == &h[..n.len()]`.
+pub fn str_starts_with_ext(h: &[u8], n: &[u8]) -> bool {
+    h.len() >= n.len() && bytes_eq_ext(n, &h[..n.len()])
+}
+
+/// `<&str as Pattern>::is_suffix_of` (`haystack.ends_with(needle)`):
+/// `h.len() >= n.len() && n == &h[h.len() - n.len()..]`.
+pub fn str_ends_with_ext(h: &[u8], n: &[u8]) -> bool {
+    h.len() >= n.len() && bytes_eq_ext(n, &h[h.len() - n.len()..])
+}
+
+/// `str::to_string` / `to_owned`: a new buffer holding the same bytes.
+pub fn copy_bytes_ext(s: &[u8]) -> Vec<u8> {
+    let mut v = Vec::new();
+    v.extend_from_slice(s);
+    v
+}
+
+/* ----------------------------------------------------------------------- *
+ *  Section 8: tokens, navigation and components.                          *
+ * ----------------------------------------------------------------------- */
+
+/// `Tokens` (release `token.rs:350`), a wrapper around `str::Split<'_, char>`
+/// with the pattern `'/'`. The state is the split's own: the haystack, the
+/// start of the part not yet yielded and the `finished` flag.
+#[derive(Clone, Copy)]
+pub struct TokensAdapted<'a> {
+    pub haystack: &'a [u8],
+    pub start: usize,
+    pub finished: bool,
+}
+
+/// `Tokens::next` (release `token.rs:357`) = `Split::next` mapped through the
+/// unchecked token constructor. Substitutions: the char searcher is a forward
+/// index loop for `b'/'`; `get_end` (with `allow_trailing_empty = true`) is the
+/// final branch; the token constructor returns the bytes.
+pub fn tokens_next_adapted<'a>(it: &mut TokensAdapted<'a>) -> Option<&'a [u8]> {
+    if it.finished {
+        return None;
+    }
+    let h = it.haystack;
+    let mut j = it.start;
+    while j < h.len() {
+        if h[j] == b'/' {
+            let tok = &h[it.start..j];
+            it.start = j + 1;
+            return Some(tok);
+        }
+        j += 1;
+    }
+    it.finished = true;
+    Some(&h[it.start..])
+}
+
+/// `Pointer::tokens` (release `pointer.rs:120`): `split('/')` then one `next`
+/// to skip the piece before the leading slash.
+pub fn tokens_adapted(ptr: &[u8]) -> TokensAdapted<'_> {
+    let mut s = TokensAdapted { haystack: ptr, start: 0, finished: false };
+    let _ = tokens_next_adapted(&mut s);
+    s
+}
+
+/// `Pointer::count` (release `pointer.rs:128`): `Iterator::count`, the default
+/// fold with an overflow-checked `count + 1`.
+pub fn count_adapted(ptr: &[u8]) -> usize {
+    let mut it = tokens_adapted(ptr);
+    let mut n: usize = 0;
+    while let Some(_) = tokens_next_adapted(&mut it) {
+        n += 1;
+    }
+    n
+}
+
+/// `Pointer::back` and `last` (release `pointer.rs:144`, `:154`):
+/// `rsplit_once('/')` keeping the back part. `i + 1` is the end of the match.
+pub fn back_adapted(ptr: &[u8]) -> Option<&[u8]> {
+    match rfind_slash_ext(ptr) {
+        None => None,
+        Some(i) => Some(&ptr[i + 1..]),
+    }
+}
+
+/// `Pointer::front` and `first` (release `pointer.rs:159`, `:176`).
+/// Substitutions: `is_root` is `is_empty`; `split_once('/')` is
+/// `find_slash_adapted` on `&ptr[1..]`.
+pub fn front_adapted(ptr: &[u8]) -> Option<&[u8]> {
+    if ptr.is_empty() {
+        return None;
+    }
+    let rest = &ptr[1..];
+    match find_slash_adapted(rest) {
+        None => Some(rest),
+        Some(i) => Some(&rest[..i]),
+    }
+}
+
+/// `Pointer::split_back` (release `pointer.rs:258`): `rsplit_once('/')`.
+pub fn split_back_adapted(ptr: &[u8]) -> Option<(&[u8], &[u8])> {
+    match rfind_slash_ext(ptr) {
+        None => None,
+        Some(i) => Some((&ptr[..i], &ptr[i + 1..])),
+    }
+}
+
+/// `Pointer::parent` (release `pointer.rs:270`): `rsplit_once('/')` keeping
+/// the front part.
+pub fn parent_adapted(ptr: &[u8]) -> Option<&[u8]> {
+    match rfind_slash_ext(ptr) {
+        None => None,
+        Some(i) => Some(&ptr[..i]),
+    }
+}
+
+/// `Iterator::advance_by` default (`core::iter::Iterator`): a `0..n` loop of
+/// `next` that returns `Err(n - i)` at the first `None`. The `NonZero` payload
+/// is the plain `usize`.
+pub fn advance_by_adapted(it: &mut TokensAdapted<'_>, n: usize) -> Result<(), usize> {
+    let mut i = 0;
+    while i < n {
+        if tokens_next_adapted(it).is_none() {
+            return Err(n - i);
+        }
+        i += 1;
+    }
+    Ok(())
+}
+
+/// `PointerIndex::get` for `usize` (release `pointer/slice.rs:14`):
+/// `tokens().nth(n)`, the default `nth` = `advance_by(n).ok()?` then `next`.
+pub fn get_index_adapted(ptr: &[u8], n: usize) -> Option<&[u8]> {
+    let mut it = tokens_adapted(ptr);
+    match advance_by_adapted(&mut it, n) {
+        Err(_) => return None,
+        Ok(()) => {}
+    }
+    tokens_next_adapted(&mut it)
+}
+
+/// `Component` (release `component.rs:4`) with the token as its encoded bytes.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ComponentAdapted<'t> {
+    Root,
+    Token(&'t [u8]),
+}
+
+/// `Components` (release `component.rs:18`): the token iterator and `sent_root`.
+#[derive(Clone, Copy)]
+pub struct ComponentsAdapted<'t> {
+    pub tokens: TokensAdapted<'t>,
+    pub sent_root: bool,
+}
+
+/// `From<&Pointer> for Components` (release `component.rs:35`) and
+/// `Pointer::components` (release `pointer.rs:506`).
+pub fn components_adapted(ptr: &[u8]) -> ComponentsAdapted<'_> {
+    ComponentsAdapted { sent_root: false, tokens: tokens_adapted(ptr) }
+}
+
+/// `Components::next` (release `component.rs:26`). `map(Component::Token)`
+/// is a `match`.
+pub fn components_next_adapted<'t>(it: &mut ComponentsAdapted<'t>) -> Option<ComponentAdapted<'t>> {
+    if !it.sent_root {
+        it.sent_root = true;
+        return Some(ComponentAdapted::Root);
+    }
+    match tokens_next_adapted(&mut it.tokens) {
+        None => None,
+        Some(t) => Some(ComponentAdapted::Token(t)),
+    }
+}
+
+/// `From<Token> for Component` (release `component.rs:11`).
+pub fn component_from_token_adapted(t: &[u8]) -> ComponentAdapted<'_> {
+    ComponentAdapted::Token(t)
+}
