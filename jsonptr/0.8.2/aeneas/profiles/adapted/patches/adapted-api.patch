+ *  Section 21: accessors, views, equality and order on byte pointers.     *
+ * ----------------------------------------------------------------------- */
+
+/// `Pointer::is_root` and `is_empty` (release `pointer.rs:133`, `:599`):
+/// `str::is_empty`.
+pub fn is_root_adapted(ptr: &[u8]) -> bool {
+    ptr.is_empty()
+}
+
+/// `Pointer::len` (release `pointer.rs:585`): `str::len`.
+pub fn len_adapted(ptr: &[u8]) -> usize {
+    ptr.len()
+}
+
+/// `str == str`, which every `PartialEq` impl among `Pointer`, `&Pointer`,
+/// `PointerBuf`, `str`, `&str`, `String` reduces to (release
+/// `pointer.rs:693-783`, `:1151`, `:1157`, derived `PartialEq`), and the
+/// derived `PartialEq` of `Token` on its encoded `Cow<str>`.
+pub fn str_eq_adapted(a: &[u8], b: &[u8]) -> bool {
+    bytes_eq_ext(a, b)
+}
+
+/// `Ord for str` = `<[u8] as Ord>::cmp` (the `u8` specialization: compare the
+/// common prefix bytewise, then the lengths), which every `PartialOrd` impl
+/// among the same types reduces to through `Some(cmp)`, and the derived order
+/// of `Token`. The memcmp is an index loop with an early exit.
+pub fn str_cmp_adapted(a: &[u8], b: &[u8]) -> core::cmp::Ordering {
+    let n = if a.len() < b.len() { a.len() } else { b.len() };
+    let mut i = 0;
+    while i < n {
+        if a[i] < b[i] {
+            return core::cmp::Ordering::Less;
+        }
+        if a[i] > b[i] {
+            return core::cmp::Ordering::Greater;
+        }
+        i += 1;
+    }
+    if a.len() < b.len() {
+        core::cmp::Ordering::Less
+    } else if a.len() > b.len() {
+        core::cmp::Ordering::Greater
+    } else {
+        core::cmp::Ordering::Equal
+    }
+}
+
+/// `PartialOrd for str` (`Some(self.cmp(other))`), which every `PartialOrd`
+/// impl among the string-backed types forwards to.
+pub fn str_partial_cmp_adapted(a: &[u8], b: &[u8]) -> Option<core::cmp::Ordering> {
+    Some(str_cmp_adapted(a, b))
+}
+
+/// Derived `PartialEq` of `Component` (release `component.rs:4`). The two
+/// references are dereferenced at entry (`ComponentAdapted` is `Copy`);
+/// matching through the references hits an Aeneas enumeration-expansion error.
+pub fn component_eq_adapted(a: ComponentAdapted<'_>, b: ComponentAdapted<'_>) -> bool {
+    match a {
+        ComponentAdapted::Root => match b {
+            ComponentAdapted::Root => true,
+            ComponentAdapted::Token(_) => false,
+        },
+        ComponentAdapted::Token(x) => match b {
+            ComponentAdapted::Root => false,
+            ComponentAdapted::Token(y) => str_eq_adapted(x, y),
+        },
+    }
+}
+
+/// Derived `Ord` of `Component` (release `component.rs:4`): variant order,
+/// then the token order.
+pub fn component_cmp_adapted(a: ComponentAdapted<'_>, b: ComponentAdapted<'_>) -> core::cmp::Ordering {
+    match a {
+        ComponentAdapted::Root => match b {
+            ComponentAdapted::Root => core::cmp::Ordering::Equal,
+            ComponentAdapted::Token(_) => core::cmp::Ordering::Less,
+        },
+        ComponentAdapted::Token(x) => match b {
+            ComponentAdapted::Root => core::cmp::Ordering::Greater,
+            ComponentAdapted::Token(y) => str_cmp_adapted(x, y),
+        },
+    }
+}
+
+/// Derived `Clone` of `PointerBuf` (release `pointer.rs:914`): `String::clone`.
+pub fn buf_clone_adapted(buf: &Vec<u8>) -> Vec<u8> {
+    buf.clone()
+}
