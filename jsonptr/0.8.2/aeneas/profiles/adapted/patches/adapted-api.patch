+/// `ParseError::invalid_encoding_len` (release `pointer.rs:1196`). `&str` is
+/// its bytes; the machine `subject.len() - 1` is kept (JSONPTR-003, N5).
+pub fn invalid_encoding_len_adapted(err: &ParseError, subject: &[u8]) -> usize {
+    match err {
+        ParseError::NoLeadingSlash => 0,
+        ParseError::InvalidEncoding { offset, .. } => {
+            if *offset < subject.len() - 1 {
+                2
+            } else {
+                1
+            }
+        }
+    }
+}
