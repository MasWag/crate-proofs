+/// A label without its text: the optional single label of `labels`.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct SpanAdapted {
+    pub offset: usize,
+    pub len: usize,
+}
+
+/// `Diagnostic::labels` for `ParseError` (release `pointer.rs:1217`): one
+/// label at `complete_offset` with `invalid_encoding_len`. The text is a
+/// fixed string and is dropped; `Box<dyn Iterator>` is the span.
+pub fn parse_error_label_adapted(err: &ParseError, subject: &[u8]) -> SpanAdapted {
+    let offset = err.complete_offset();
+    let len = invalid_encoding_len_adapted(err, subject);
+    SpanAdapted { offset, len }
+}
+
+/// `Diagnostic::labels` for `EncodingError` (release `token.rs:422`). The
+/// machine `self.offset - 1` is kept (N8).
+pub fn encoding_error_label_adapted(err: &EncodingError, subject: &[u8]) -> SpanAdapted {
+    let offset = match err.source {
+        InvalidEncoding::Tilde => {
+            if err.offset == subject.len() {
+                err.offset - 1
+            } else {
+                err.offset
+            }
+        }
+        InvalidEncoding::Slash => err.offset,
+    };
+    SpanAdapted { offset, len: 1 }
+}
+
+/// A UTF-8 continuation byte (`0x80..=0xBF`): not the start of a `char`.
+pub fn is_cont_adapted(b: u8) -> bool {
+    b >= 128 && b <= 191
+}
+
+/// `subject.chars().position(|c| c != '0')` over the UTF-8 bytes: a `char`
+/// starts at a non-continuation byte, and it equals `'0'` exactly when that
+/// byte is `b'0'`. The count is in `char`s, as in the release.
+pub fn position_non_zero_char_adapted(s: &[u8]) -> Option<usize> {
+    let mut i = 0;
+    let mut chars: usize = 0;
+    while i < s.len() {
+        let b = s[i];
+        if !is_cont_adapted(b) {
+            if b != b'0' {
+                return Some(chars);
+            }
+            chars += 1;
+        }
+        i += 1;
+    }
+    None
+}
+
+/// `subject.chars().skip(skip).position(|c| c.is_ascii_digit())` over the
+/// UTF-8 bytes, counting `char`s as the release does.
+pub fn position_digit_after_chars_adapted(s: &[u8], skip: usize) -> Option<usize> {
+    let mut i = 0;
+    let mut chars: usize = 0;
+    let mut pos: usize = 0;
+    while i < s.len() {
+        let b = s[i];
+        if !is_cont_adapted(b) {
+            if chars >= skip {
+                if b.is_ascii_digit() {
+                    return Some(pos);
+                }
+                pos += 1;
+            }
+            chars += 1;
+        }
+        i += 1;
+    }
+    None
+}
+
+/// `Diagnostic::labels` for `ParseIndexError` (release `index.rs:365-391`)
+/// on the subject's bytes. `Box<dyn Iterator>` is the optional span; the
+/// fixed texts are dropped; `expect` is a `panic!` (N1);
+/// `unwrap_or(subject.len())` keeps the byte length (N2).
+pub fn parse_index_error_label_adapted(err: &crate::index::ParseIndexErrorAdapted, subject: &[u8]) -> Option<SpanAdapted> {
+    match err {
+        crate::index::ParseIndexErrorAdapted::InvalidInteger(_) => None,
+        crate::index::ParseIndexErrorAdapted::LeadingZeros => {
+            let len = match position_non_zero_char_adapted(subject) {
+                Some(p) => p,
+                None => panic!("starts with zeros"),
+            };
+            Some(SpanAdapted { offset: 0, len })
+        }
+        crate::index::ParseIndexErrorAdapted::InvalidCharacter(e) => {
+            let len = match position_digit_after_chars_adapted(subject, e.offset) {
+                Some(p) => p,
+                None => subject.len(),
+            };
+            Some(SpanAdapted { offset: e.offset, len })
+        }
+    }
+}
