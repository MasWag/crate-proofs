+/* ----------------------------------------------------------------------- *
+ *  Section 10: byte split.                                                *
+ * ----------------------------------------------------------------------- */
+
+/// `Pointer::split_at_offset` (release `pointer.rs:232`); the deprecated
+/// `split_at` forwards to it. Substitutions: `as_bytes().get(offset).copied()`
+/// is an explicit bounds test and index; `str::split_at` is `<[u8]>::split_at`.
+/// The dropped char-boundary assertion of `str::split_at` cannot fail here:
+/// the byte at `offset` is the ASCII `/`.
+pub fn split_at_offset_adapted(ptr: &[u8], offset: usize) -> Option<(&[u8], &[u8])> {
+    let b = if offset < ptr.len() { Some(ptr[offset]) } else { None };
+    match b {
+        Some(b'/') => {}
+        _ => return None,
+    }
+    let (head, tail) = ptr.split_at(offset);
+    Some((head, tail))
+}
+
+/* ----------------------------------------------------------------------- *
+ *  Section 11: comparison and prefix operations.                          *
+ * ----------------------------------------------------------------------- */
+
+/// `Pointer::starts_with` (release `pointer.rs:307`). `as_str` is the bytes.
+pub fn starts_with_adapted(s: &[u8], other: &[u8]) -> bool {
+    str_starts_with_ext(s, other) && (other.len() == s.len() || s[other.len()] == b'/')
+}
+
+/// `Pointer::ends_with` (release `pointer.rs:298`).
+pub fn ends_with_adapted(s: &[u8], other: &[u8]) -> bool {
+    (s.is_empty() && other.is_empty()) || (!other.is_empty() && str_ends_with_ext(s, other))
+}
+
+/// `Pointer::strip_suffix` (release `pointer.rs:278`): `str::strip_suffix`
+/// (`<&str as Pattern>::strip_suffix_of`), then the unchecked constructor.
+pub fn strip_suffix_adapted<'a>(s: &'a [u8], suffix: &[u8]) -> Option<&'a [u8]> {
+    if str_ends_with_ext(s, suffix) {
+        let i = s.len() - suffix.len();
+        Some(&s[..i])
+    } else {
+        None
+    }
+}
+
+/// `Pointer::strip_prefix` (release `pointer.rs:287`): `str::strip_prefix`
+/// (`<&str as Pattern>::strip_prefix_of`), then the unchecked constructor.
+/// Kept as in the release, so JSONPTR-001 is preserved.
+pub fn strip_prefix_adapted<'a>(s: &'a [u8], prefix: &[u8]) -> Option<&'a [u8]> {
+    if str_starts_with_ext(s, prefix) {
+        Some(&s[prefix.len()..])
+    } else {
+        None
+    }
+}
+
+/// `Pointer::intersection` (release `pointer.rs:396`). Substitutions: `zip`
+/// is a loop that advances `self`'s tokens first and stops when either side
+/// ends; `Token != Token` is `!bytes_eq_ext` on the encoded bytes; `root()` is
+/// the empty slice; `map_or` is a `match`.
+pub fn intersection_adapted<'a>(s: &'a [u8], other: &[u8]) -> &'a [u8] {
+    if s.is_empty() || other.is_empty() {
+        return &[];
+    }
+    let mut idx: usize = 0;
+    let mut a_it = tokens_adapted(s);
+    let mut b_it = tokens_adapted(other);
+    loop {
+        let a = match tokens_next_adapted(&mut a_it) {
+            None => break,
+            Some(a) => a,
+        };
+        let b = match tokens_next_adapted(&mut b_it) {
+            None => break,
+            Some(b) => b,
+        };
+        if !bytes_eq_ext(a, b) {
+            break;
+        }
+        idx += a.len() + 1;
+    }
+    match split_at_offset_adapted(s, idx) {
+        None => s,
+        Some((head, _)) => head,
+    }
+}
+
+/* ----------------------------------------------------------------------- *
+ *  Section 12: buffer construction and mutation.                          *
+ *  `PointerBuf(String)` is a `Vec<u8>`; a token argument is its encoded   *
+ *  bytes (the `Into<Token>` conversion is target 2).                      *
+ * ----------------------------------------------------------------------- */
+
+/// `PointerBuf::new`, `root`, `Default` (release `pointer.rs:921`, `:926`, `:914`).
+pub fn buf_new_adapted() -> Vec<u8> {
+    Vec::new()
+}
+
+/// `Pointer::to_buf` (release `pointer.rs:115`), `ToOwned::to_owned`.
+pub fn to_buf_adapted(ptr: &[u8]) -> Vec<u8> {
+    copy_bytes_ext(ptr)
+}
+
+/// `PointerBuf::from_tokens` (release `pointer.rs:951`) over a slice of
+/// owned encoded tokens (a slice of borrowed slices is an unsupported nested
+/// borrow for Aeneas). The `for` loop is an index loop; `push('/')` and
+/// `push_str` are a byte push and `extend_from_slice`.
+pub fn from_tokens_adapted(tokens: &[Vec<u8>]) -> Vec<u8> {
+    let mut inner = Vec::new();
+    let mut i = 0;
+    while i < tokens.len() {
+        inner.push(b'/');
+        inner.extend_from_slice(&tokens[i]);
+        i += 1;
+    }
+    inner
+}
+
+/// `PointerBuf::push_back` (release `pointer.rs:972`).
+pub fn push_back_adapted(buf: &mut Vec<u8>, token: &[u8]) {
+    buf.push(b'/');
+    buf.extend_from_slice(token);
+}
+
+/// `PointerBuf::push_front` (release `pointer.rs:966`). `insert(0, '/')`
+/// then `insert_str(1, t)` leave `"/" ++ t ++ old`; here that buffer is built
+/// directly (push, then two `extend_from_slice`) and stored. Reason: the
+/// unchanged Aeneas model of `Vec::insert` fails at `index == len`, which Rust
+/// allows (e.g. `insert(0, ..)` on the empty buffer). The dropped
+/// char-boundary assertions cannot fail on a buffer that holds a pointer.
+pub fn push_front_adapted(buf: &mut Vec<u8>, token: &[u8]) {
+    let mut nb = Vec::new();
+    nb.push(b'/');
+    nb.extend_from_slice(token);
+    nb.extend_from_slice(buf);
+    *buf = nb;
+}
+
+/// `PointerBuf::pop_back` (release `pointer.rs:978`). Substitutions: `rfind`
+/// is `rfind_slash_ext`; `split_off(idx + 1)` and `pop()` (which removes the
+/// one-byte `/`) are rebuilt buffers with the same final contents.
+pub fn pop_back_adapted(buf: &mut Vec<u8>) -> Option<Vec<u8>> {
+    match rfind_slash_ext(buf) {
+        Some(idx) => {
+            let at = idx + 1;
+            let back = copy_bytes_ext(&buf[at..]);
+            let head = copy_bytes_ext(&buf[..at]);
+            let new_len = head.len() - 1;
+            *buf = copy_bytes_ext(&head[..new_len]);
+            Some(back)
+        }
+        None => None,
+    }
+}
+
+/// `PointerBuf::pop_front` (release `pointer.rs:990`). Substitutions:
+/// `(!is_root()).then(..)` is an early return; `split_off(idx + 1)` with
+/// `mem::replace`, and `mem::take`, are rebuilt buffers; `remove(0)` (the
+/// one-byte `/`) is a copy of `&token[1..]`.
+pub fn pop_front_adapted(buf: &mut Vec<u8>) -> Option<Vec<u8>> {
+    if buf.len() == 0 {
+        return None;
+    }
+    let token = match find_slash_adapted(&buf[1..]) {
+        Some(idx) => {
+            let at = idx + 1;
+            let tail = copy_bytes_ext(&buf[at..]);
+            let head = copy_bytes_ext(&buf[..at]);
+            *buf = tail;
+            head
+        }
+        None => {
+            let all = copy_bytes_ext(&buf[..]);
+            *buf = Vec::new();
+            all
+        }
+    };
+    Some(copy_bytes_ext(&token[1..]))
+}
+
+/// `PointerBuf::append` (release `pointer.rs:1007`). The returned `&Self` is
+/// the buffer itself and is not returned separately.
+pub fn append_adapted(buf: &mut Vec<u8>, other: &[u8]) {
+    if buf.len() == 0 {
+        *buf = copy_bytes_ext(other);
+    } else if !other.is_empty() {
+        buf.extend_from_slice(other);
+    }
+}
+
+/// `PointerBuf::replace` (release `pointer.rs:1022`). Substitutions: `collect`
+/// is a loop of `push` that stores owned copies of the encoded tokens (a
+/// vector of borrowed slices hits Aeneas internal and nested-borrow errors);
+/// `tokens.get(index).map(to_owned)` is a bounds test and a copy;
+/// `tokens[index] = token.into()` stores a copy of the encoded token; the
+/// rebuild loop is an index loop.
+pub fn replace_adapted(buf: &mut Vec<u8>, index: usize, token: &[u8]) -> Result<Option<Vec<u8>>, ReplaceError> {
+    if buf.len() == 0 {
+        return Err(ReplaceError { count: count_adapted(buf), index });
+    }
+    let mut tokens: Vec<Vec<u8>> = Vec::new();
+    let mut it = tokens_adapted(buf);
+    while let Some(t) = tokens_next_adapted(&mut it) {
+        tokens.push(copy_bytes_ext(t));
+    }
+    if index >= tokens.len() {
+        return Err(ReplaceError { count: tokens.len(), index });
+    }
+    let old = if index < tokens.len() { Some(copy_bytes_ext(&tokens[index])) } else { None };
+    tokens[index] = copy_bytes_ext(token);
+    let mut nb = Vec::new();
+    let mut i = 0;
+    while i < tokens.len() {
+        nb.push(b'/');
+        nb.extend_from_slice(&tokens[i]);
+        i += 1;
+    }
+    *buf = nb;
+    Ok(old)
+}
+
+/// `PointerBuf::clear` (release `pointer.rs:1054`): `String::clear` leaves
+/// the empty buffer; here a new empty buffer (capacity is not observed).
+pub fn clear_adapted(buf: &mut Vec<u8>) {
+    *buf = Vec::new();
+}
