+//! Resolve explicit mappings missed by the source scanner from a compiler catalogue.
+use crate::{config::Project, scan::Contract};
+use anyhow::{ensure, Context, Result};
+use serde_json::Value;
+use std::{fs, path::Path, process::Command};
+
+pub(super) struct Catalogue {
+    document: Value,
+    pub(super) observation: String,
+}
+
+impl Catalogue {
+    pub(super) fn capture(project: &Project, toolchain: &str) -> Result<Self> {
+        let target = tempfile::tempdir()?;
+        let package = project
+            .manifest
+            .parent()
+            .context("Missing package directory")?;
+        let output = Command::new("cargo")
+            .arg(format!("+{toolchain}"))
+            .args(["rustdoc", "--locked", "--lib", "--manifest-path"])
+            .arg(&project.manifest)
+            .args(["--", "-Z", "unstable-options", "--output-format", "json"])
+            .current_dir(package)
+            .env("CARGO_TARGET_DIR", target.path())
+            .output()
+            .context("Generate Rustdoc JSON with the selected nightly")?;
+        ensure!(
+            output.status.success(),
+            "Rustdoc API discovery failed: {}",
+            String::from_utf8_lossy(&output.stderr)
+        );
+        let path = target
+            .path()
+            .join("doc")
+            .join(format!("{}.json", project.lib_name));
+        let bytes = fs::read(&path).context("Read compiler-generated Rustdoc catalogue")?;
+        let document: Value = serde_json::from_slice(&bytes)?;
+        let format = document["format_version"]
+            .as_u64()
+            .context("Missing Rustdoc format version")?;
+        ensure!(
+            matches!(format, 60 | 61),
+            "Unsupported Rustdoc JSON format {format}"
+        );
+        let root = id(&document["root"]).context("Missing Rustdoc root ID")?;
+        ensure!(
+            document["index"][&root]["name"] == project.lib_name
+                && document["crate_version"] == project.version
+                && document["includes_private"] == false,
+            "Rustdoc catalogue does not match the selected public library"
+        );
+        let sha = crate::preparation::sha(&path)?;
+        Ok(Self {
+            document,
+            observation: format!(
+                "Rustdoc catalogue from {toolchain} (format {format}, SHA-256 {sha})"
+            ),
+        })
+    }
+
+    pub(super) fn resolve(&self, project: &Project, api: &str) -> Result<Vec<Contract>> {
+        let paths = self.document["paths"]
+            .as_object()
+            .context("Missing Rustdoc paths")?;
+        let index = self.document["index"]
+            .as_object()
+            .context("Missing Rustdoc index")?;
+        let package = project
+            .manifest
+            .parent()
+            .context("Missing package directory")?;
+        let mut found = vec![];
+        for (item_id, path) in paths {
+            if path["crate_id"] != 0 {
+                continue;
+            }
+            let Some(public_path) = path_string(&path["path"]) else {
+                continue;
+            };
+            let Some(relative) = public_path.strip_prefix(&format!("{}::", project.lib_name))
+            else {
+                continue;
+            };
+            let Some(item) = index
+                .get(item_id)
+                .filter(|item| item["visibility"] == "public")
+            else {
+                continue;
+            };
+            if relative == api && item["inner"]["function"].is_object() {
+                found.push(callable(package, vec![relative.to_owned()], &item["span"])?);
+            }
+
+            let Some(name) = api
+                .strip_prefix(relative)
+                .and_then(|suffix| suffix.strip_prefix("::"))
+            else {
+                continue;
+            };
+            if name.contains("::") {
+                continue;
+            }
+            let impls = ["struct", "enum", "union"]
+                .into_iter()
+                .find_map(|kind| item["inner"][kind]["impls"].as_array());
+            let Some(impls) = impls else { continue };
+            for impl_id in impls.iter().filter_map(id) {
+                let Some(implementation) = index.get(&impl_id) else {
+                    continue;
+                };
+                let imp = &implementation["inner"]["impl"];
+                let trait_ref = &imp["trait"];
+                if !trait_ref.is_object()
+                    || !trait_ref["args"].is_null()
+                    || !imp["blanket_impl"].is_null()
+                    || imp["is_synthetic"] != false
+                    || imp["is_negative"] != false
+                    || imp["for"]["resolved_path"]["args"].is_object()
+                    || id(&imp["for"]["resolved_path"]["id"]).as_deref() != Some(item_id)
+                    || !implementation["span"].is_object()
+                {
+                    continue;
+                }
+                let Some(trait_path) = id(&trait_ref["id"])
+                    .and_then(|id| paths.get(&id))
+                    .and_then(|path| path_string(&path["path"]))
+                else {
+                    continue;
+                };
+                let method = imp["items"]
+                    .as_array()
+                    .into_iter()
+                    .flatten()
+                    .filter_map(id)
+                    .filter_map(|id| index.get(&id))
+                    .find(|method| {
+                        method["name"] == name && method["inner"]["function"].is_object()
+                    });
+                let default = imp["provided_trait_methods"]
+                    .as_array()
+                    .is_some_and(|methods| methods.iter().any(|method| method == name));
+                if method.is_some() || default {
+                    let span = method
+                        .map(|method| &method["span"])
+                        .filter(|span| span.is_object())
+                        .unwrap_or(&implementation["span"]);
+                    let canonical = format!("<{public_path} as {trait_path}>::{name}");
+                    let mut api_paths = vec![canonical];
+                    if let Some(label) = trait_ref["path"].as_str() {
+                        let display = format!("<{public_path} as {label}>::{name}");
+                        if !api_paths.contains(&display) {
+                            api_paths.push(display);
+                        }
+                    }
+                    found.push(callable(package, api_paths, span)?);
+                }
+            }
+        }
+        Ok(found)
+    }
+}
+
+fn id(value: &Value) -> Option<String> {
+    value
+        .as_str()
+        .map(str::to_owned)
+        .or_else(|| value.as_u64().map(|id| id.to_string()))
+}
+
+fn path_string(path: &Value) -> Option<String> {
+    let segments = path
+        .as_array()?
+        .iter()
+        .map(Value::as_str)
+        .collect::<Option<Vec<_>>>()?;
+    Some(segments.join("::"))
+}
+
+fn callable(package: &Path, api_paths: Vec<String>, span: &Value) -> Result<Contract> {
+    let file = package
+        .join(
+            span["filename"]
+                .as_str()
+                .context("Missing Rustdoc source span")?,
+        )
+        .canonicalize()
+        .context("Resolve Rustdoc source span")?;
+    ensure!(
+        file.starts_with(package) && file.is_file(),
+        "Rustdoc source span escapes the selected package"
+    );
+    let first_line = span["begin"][0]
+        .as_u64()
+        .context("Missing Rustdoc source line")? as usize;
+    let last_line = span["end"][0]
+        .as_u64()
+        .context("Missing Rustdoc source line")? as usize;
+    Ok(Contract {
+        harness: api_paths[0].clone(),
+        api_paths,
+        file,
+        first_line,
+        last_line,
+        precondition: "true".to_owned(),
+    })
+}
+
