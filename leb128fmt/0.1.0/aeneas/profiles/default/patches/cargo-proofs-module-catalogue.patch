+fn proof_batches(tool: &Tool) -> Vec<Tool> {
+    // Manifest discovery starts from the declared module closure. Explicit
+    // mappings, in contrast, can be checked in independent environments.
+    if !tool.proof_modules.is_empty() || tool.proofs.is_empty() {
+        return vec![tool.clone()];
+    }
+    let mut groups = BTreeMap::<&str, Vec<Proof>>::new();
+    for proof in &tool.proofs {
+        groups.entry(&proof.module).or_default().push(proof.clone());
+    }
+    groups
+        .into_values()
+        .map(|proofs| Tool {
+            proofs,
+            ..tool.clone()
+        })
+        .collect()
+}
