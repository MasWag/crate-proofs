let%span slemmas'1 = "/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/lemmas.rs" 33 11 33 58
let%span slemmas'2 = "/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/lemmas.rs" 34 10 34 39
let%span sspec = "/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 113 16 115 57

use creusot.int.UInt8
use seq.Seq
use int.Int

predicate source_line_start [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 112 0 112 60] (s: Seq.seq UInt8.t) (a: int) (i: int) =
  [%#sspec] 0 <= a
  /\ a <= i
  /\ i < Seq.length s
  /\ (a = 0 \/ Seq.get s (a - 1) = (10: UInt8.t)) /\ (forall j: int. a <= j /\ j < i -> Seq.get s j <> (10: UInt8.t))

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant s : Seq.seq UInt8.t

constant i : int

constant at' : int

function find_start [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/lemmas.rs" 36 0 36 48] (s: Seq.seq UInt8.t) (i: int) (at': int) : int

goal vc_find_start: ([%#slemmas'0] 0 <= at' /\ at' <= i /\ i < Seq.length s)
  -> ([%#slemmas'1] forall j: int. at' <= j /\ j < i -> Seq.get s j <> (10: UInt8.t))
  -> (if at' = 0 then
    [@stop_split] [@expl:find_start ensures] [%#slemmas'2] source_line_start s at' i
  else
    if Seq.get s (at' - 1) = (10: UInt8.t) then
      [@stop_split] [@expl:find_start ensures] [%#slemmas'2] source_line_start s at' i
    else
      (([@stop_split] [@expl:find_start requires] ([@stop_split] [@expl:find_start requires #0] [%#slemmas'0] 0
              <= at' - 1
            /\ at' - 1 <= i /\ i < Seq.length s)
          /\ ([@stop_split] [@expl:find_start requires #1] [%#slemmas'1] forall j: int. at' - 1 <= j /\ j < i
            -> Seq.get s j <> (10: UInt8.t)))
        /\ ([@expl:variant decreases] well_founded_relation_Int ([%#slemmas] at') ([%#slemmas] at' - 1)))
      /\ (([@stop_split] [@expl:find_start ensures] [%#slemmas'2] source_line_start s (find_start s i (at' - 1)) i)
      -> ([@stop_split] [@expl:find_start ensures] [%#slemmas'2] source_line_start s (find_start s i (at' - 1)) i))
  
  )
