function bytes_head_tail [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/utf8.rs" 45 0 45 34] (s: Seq.seq UInt8.t) : ()
 =
  [%#sutf8'21] let joined = Seq.(++) (Seq.singleton (Seq.get s 0)) (tail_u8 s) in let _ = bytes_extensional_u8 joined s in ()

axiom bytes_head_tail_spec: forall s: Seq.seq UInt8.t. ([%#sutf8'14] gt_log_Int (Seq.length s) 0)
    -> ([%#sutf8'15] Seq.(++) (Seq.singleton (Seq.get s 0)) (tail_u8 s) = s)

