constant a : Seq.seq UInt8.t

constant b : Seq.seq UInt8.t

constant output : Seq.seq UInt8.t

function retained_nonascii_prefix [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/utf8.rs" 154 0 154 72] (a: Seq.seq UInt8.t) (b: Seq.seq UInt8.t) (output: Seq.seq UInt8.t) : ()

goal vc_retained_nonascii_prefix: ([%#sutf8'0] forall i: int. 0 <= i /\ i < Seq.length a
      -> ge_log_Int (UInt8.t'int (Seq.get a i)) 128)
  -> ([%#sutf8'1] ascii_erasure (Seq.(++) a b) output)
  -> (if gt_log_Int (Seq.length a) 0 then
    gt_log_Int (Seq.length (Seq.(++) a b)) 0
    && Seq.get (Seq.(++) a b) 0 = Seq.get a 0
    && ([@stop_split] [@expl:nonascii_head requires] ([@stop_split] [@expl:nonascii_head requires #0] [%#sutf8'5] gt_log_Int (Seq.length (Seq.(++) a b)) 0
        /\ ascii_erasure (Seq.(++) a b) output)
      /\ ([@stop_split] [@expl:nonascii_head requires #1] [%#sutf8'6] ge_log_Int (UInt8.t'int (Seq.get (Seq.(++) a b) 0)) 128))
    /\ (([@stop_split] [@expl:nonascii_head ensures] ([@stop_split] [@expl:nonascii_head ensures #0] [%#sutf8'7] gt_log_Int (Seq.length output) 0
        /\ Seq.get output 0 = Seq.get (Seq.(++) a b) 0)
      /\ ([@stop_split] [@expl:nonascii_head ensures #1] [%#sutf8'8] ascii_erasure (tail_u8 (Seq.(++) a b)) (tail_u8 output)))
    -> (let _ = nonascii_head (Seq.(++) a b) output in Seq.get output 0 = Seq.get a 0
    && ([@stop_split] [@expl:tail_concat requires] [%#sutf8'9] gt_log_Int (Seq.length a) 0)
    /\ (([@stop_split] [@expl:tail_concat ensures] [%#sutf8'10] tail_u8 (Seq.(++) a b) = Seq.(++) (tail_u8 a) b)
    -> (let _ = tail_concat_u8 a b in (([@stop_split] [@expl:retained_nonascii_prefix requires] ([@stop_split] [@expl:retained_nonascii_prefix requires #0] [%#sutf8'0] forall i: int. 0
                <= i
              /\ i < Seq.length (tail_u8 a) -> ge_log_Int (UInt8.t'int (Seq.get (tail_u8 a) i)) 128)
        /\ ([@stop_split] [@expl:retained_nonascii_prefix requires #1] [%#sutf8'1] ascii_erasure (Seq.(++) (tail_u8 a) b) (tail_u8 output)))
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sutf8] Seq.length a) ([%#sutf8] Seq.length (tail_u8 a))))
    /\ (([@stop_split] [@expl:retained_nonascii_prefix ensures] ([@stop_split] [@expl:retained_nonascii_prefix ensures #0] [%#sutf8'2] Seq.length (tail_u8 a)
        <= Seq.length (tail_u8 output))
      /\ ([@stop_split] [@expl:retained_nonascii_prefix ensures #1] [%#sutf8'3] Seq.([..]) (tail_u8 output) 0 (Seq.length (tail_u8 a))
        = tail_u8 a)
      /\ ([@stop_split] [@expl:retained_nonascii_prefix ensures #2] [%#sutf8'4] ascii_erasure b (Seq.([..]) (tail_u8 output) (Seq.length (tail_u8 a)) (Seq.length (tail_u8 output)))))
    -> (let _ = retained_nonascii_prefix (tail_u8 a) b (tail_u8 output) in Seq.length a <= Seq.length output
    && ([@stop_split] [@expl:slice_tail requires] [%#sutf8'11] 0 < Seq.length a /\ Seq.length a <= Seq.length output)
    /\ (([@stop_split] [@expl:slice_tail ensures] ([@stop_split] [@expl:slice_tail ensures #0] [%#sutf8'12] tail_u8 (Seq.([..]) output 0 (Seq.length a))
        = Seq.([..]) (tail_u8 output) 0 (Seq.length a - 1))
      /\ ([@stop_split] [@expl:slice_tail ensures #1] [%#sutf8'13] Seq.([..]) (tail_u8 output) (Seq.length a
        - 1) (Seq.length (tail_u8 output))
      = Seq.([..]) output (Seq.length a) (Seq.length output)))
    -> (let _ = slice_tail output (Seq.length a) in ([@stop_split] [@expl:bytes_head_tail requires] [%#sutf8'14] gt_log_Int (Seq.length (Seq.([..]) output 0 (Seq.length a))) 0)
    /\ (([@stop_split] [@expl:bytes_head_tail ensures] [%#sutf8'15] Seq.(++) (Seq.singleton (Seq.get (Seq.([..]) output 0 (Seq.length a)) 0)) (tail_u8 (Seq.([..]) output 0 (Seq.length a)))
      = Seq.([..]) output 0 (Seq.length a))
    -> (let _ = bytes_head_tail (Seq.([..]) output 0 (Seq.length a)) in ([@stop_split] [@expl:bytes_head_tail requires] [%#sutf8'14] gt_log_Int (Seq.length a) 0)
    /\ (([@stop_split] [@expl:bytes_head_tail ensures] [%#sutf8'15] Seq.(++) (Seq.singleton (Seq.get a 0)) (tail_u8 a)
      = a)
    -> (let _ = bytes_head_tail a in Seq.get (Seq.([..]) output 0 (Seq.length a)) 0 = Seq.get a 0
    && Seq.([..]) output 0 (Seq.length a) = a
    && ([@stop_split] [@expl:retained_nonascii_prefix ensures] ([@stop_split] [@expl:retained_nonascii_prefix ensures #0] [%#sutf8'2] Seq.length a
      <= Seq.length output)
    /\ ([@stop_split] [@expl:retained_nonascii_prefix ensures #1] [%#sutf8'3] Seq.([..]) output 0 (Seq.length a) = a)
    /\ ([@stop_split] [@expl:retained_nonascii_prefix ensures #2] [%#sutf8'4] ascii_erasure b (Seq.([..]) output (Seq.length a) (Seq.length output))))))))))))))))
  else
    a = (Seq.empty: Seq.seq UInt8.t)
    && Seq.(++) a b = b
    && Seq.([..]) output 0 (Seq.length output) = output
    && ([@stop_split] [@expl:retained_nonascii_prefix ensures] ([@stop_split] [@expl:retained_nonascii_prefix ensures #0] [%#sutf8'2] Seq.length a
      <= Seq.length output)
    /\ ([@stop_split] [@expl:retained_nonascii_prefix ensures #1] [%#sutf8'3] Seq.([..]) output 0 (Seq.length a) = a)
    /\ ([@stop_split] [@expl:retained_nonascii_prefix ensures #2] [%#sutf8'4] ascii_erasure b (Seq.([..]) output (Seq.length a) (Seq.length output))))
