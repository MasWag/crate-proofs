use creusot.int.UInt8
use seq.Seq
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

function tail_u8 (self: Seq.seq UInt8.t) : Seq.seq UInt8.t = [%#sseq] Seq.([..]) self 1 (Seq.length self)

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate ascii_erasure [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/utf8.rs" 123 0 123 61] (input: Seq.seq UInt8.t) (output: Seq.seq UInt8.t)

axiom ascii_erasure_def:
  forall input: Seq.seq UInt8.t, output: Seq.seq UInt8.t [ascii_erasure input output]. ascii_erasure input output
    = ([%#sutf8'17] if Seq.length input = 0 then
      Seq.length output = 0
    else
      UInt8.t'int (Seq.get input 0) < 128 /\ ascii_erasure (tail_u8 input) output
      \/ gt_log_Int (Seq.length output) 0
      /\ Seq.get input 0 = Seq.get output 0 /\ ascii_erasure (tail_u8 input) (tail_u8 output)
    )

function nonascii_head [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/utf8.rs" 138 0 138 53] (input: Seq.seq UInt8.t) (output: Seq.seq UInt8.t) : ()
 = [%#sutf8'18] ()

axiom nonascii_head_spec:
  forall input: Seq.seq UInt8.t, output: Seq.seq UInt8.t. ([%#sutf8'5] gt_log_Int (Seq.length input) 0
      /\ ascii_erasure input output)
    -> ([%#sutf8'6] ge_log_Int (UInt8.t'int (Seq.get input 0)) 128)
    -> ([%#sutf8'7] gt_log_Int (Seq.length output) 0 /\ Seq.get output 0 = Seq.get input 0)

axiom nonascii_head_spec'0:
  forall input: Seq.seq UInt8.t, output: Seq.seq UInt8.t. ([%#sutf8'5] gt_log_Int (Seq.length input) 0
      /\ ascii_erasure input output)
    -> ([%#sutf8'6] ge_log_Int (UInt8.t'int (Seq.get input 0)) 128)
    -> ([%#sutf8'8] ascii_erasure (tail_u8 input) (tail_u8 output))

function bytes_extensional_u8 [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/utf8.rs" 40 0 40 49] (a: Seq.seq UInt8.t) (b: Seq.seq UInt8.t) : ()
 = [%#sutf8'25] ()

axiom bytes_extensional_u8_spec: forall a: Seq.seq UInt8.t, b: Seq.seq UInt8.t. ([%#sutf8'22] Seq.length a
      = Seq.length b)
    -> ([%#sutf8'23] forall i: int. 0 <= i /\ i < Seq.length a -> Seq.get a i = Seq.get b i) -> ([%#sutf8'24] a = b)

function tail_concat_u8 [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/utf8.rs" 57 0 57 43] (a: Seq.seq UInt8.t) (b: Seq.seq UInt8.t) : ()
 = [%#sutf8'19] let _ = bytes_extensional_u8 (tail_u8 (Seq.(++) a b)) (Seq.(++) (tail_u8 a) b) in ()

axiom tail_concat_u8_spec: forall a: Seq.seq UInt8.t, b: Seq.seq UInt8.t. ([%#sutf8'9] gt_log_Int (Seq.length a) 0)
    -> ([%#sutf8'10] tail_u8 (Seq.(++) a b) = Seq.(++) (tail_u8 a) b)

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

function slice_tail [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/utf8.rs" 67 0 67 37] (s: Seq.seq UInt8.t) (n: int) : ()
 = [%#sutf8'20] let a = tail_u8 (Seq.([..]) s 0 n) in let b = Seq.([..]) (tail_u8 s) 0 (n
  - 1) in let _ = bytes_extensional_u8 a b in let a'0 = Seq.([..]) (tail_u8 s) (n
  - 1) (Seq.length (tail_u8 s)) in let b'0 = Seq.([..]) s n (Seq.length s) in let _ = bytes_extensional_u8 a'0 b'0 in ()

axiom slice_tail_spec: forall s: Seq.seq UInt8.t, n: int. ([%#sutf8'11] 0 < n /\ n <= Seq.length s)
    -> ([%#sutf8'12] tail_u8 (Seq.([..]) s 0 n) = Seq.([..]) (tail_u8 s) 0 (n - 1))

axiom slice_tail_spec'0: forall s: Seq.seq UInt8.t, n: int. ([%#sutf8'11] 0 < n /\ n <= Seq.length s)
