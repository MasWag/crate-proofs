use creusot.int.UInt8
use seq.Seq
use creusot.prelude.Char
use map.Map
use int.Int

function tail_char (self: Seq.seq Char.t) : Seq.seq Char.t = [%#sseq'1] Seq.([..]) self 1 (Seq.length self)

function flat_map_char (self: Seq.seq Char.t) (other: Map.map Char.t (Seq.seq UInt8.t)) : Seq.seq UInt8.t

axiom flat_map_char_def:
  forall self: Seq.seq Char.t, other: Map.map Char.t (Seq.seq UInt8.t) [flat_map_char self other]. flat_map_char self other
    = ([%#sseq'0] if Seq.length self = 0 then
      Seq.empty: Seq.seq UInt8.t
    else
      Seq.(++) (Map.get other (Seq.get self 0)) (flat_map_char (tail_char self) other)
    )

function to_utf8_char (self: Char.t) : Seq.seq UInt8.t

axiom to_utf8_char_spec: forall self: Char.t [to_utf8_char self]. [%#schar] 1 <= Seq.length (to_utf8_char self)
    /\ Seq.length (to_utf8_char self) <= 4

function to_bytes (self: Seq.seq Char.t) : Seq.seq UInt8.t =
  [%#sstring] flat_map_char self (fun (c: Char.t) -> to_utf8_char c)

predicate valid [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/utf8.rs" 6 0 6 36] (bytes: Seq.seq UInt8.t) =
  [%#sutf8'2] exists chars: Seq.seq Char.t. to_bytes chars = bytes

predicate index_Mapping_Seq_char_bool [@inline:trivial] (self: Map.map (Seq.seq Char.t) bool) (a: Seq.seq Char.t) =
  [%#smapping] Map.get self a

meta "rewrite_def" predicate index_Mapping_Seq_char_bool

function such_that_Seq_char (p: Map.map (Seq.seq Char.t) bool) : Seq.seq Char.t

axiom such_that_Seq_char_spec:
  forall p: Map.map (Seq.seq Char.t) bool [such_that_Seq_char p]. ([%#slogic] exists x: Seq.seq Char.t. index_Mapping_Seq_char_bool p x)
    -> ([%#slogic'0] index_Mapping_Seq_char_bool p (such_that_Seq_char p))

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

function concat_assoc_u8 (self: Seq.seq UInt8.t) (other1: Seq.seq UInt8.t) (other2: Seq.seq UInt8.t) : ()

axiom concat_assoc_u8_spec:
  forall self: Seq.seq UInt8.t, other1: Seq.seq UInt8.t, other2: Seq.seq UInt8.t. [%#sseq'2] Seq.(++) (Seq.(++) self other1) other2
    = Seq.(++) self (Seq.(++) other1 other2)

function bytes_extensional_char [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/utf8.rs" 40 0 40 49] (a: Seq.seq Char.t) (b: Seq.seq Char.t) : ()
 = [%#sutf8'11] ()

axiom bytes_extensional_char_spec: forall a: Seq.seq Char.t, b: Seq.seq Char.t. ([%#sutf8'8] Seq.length a
      = Seq.length b)
    -> ([%#sutf8'9] forall i: int. 0 <= i /\ i < Seq.length a -> Seq.get a i = Seq.get b i) -> ([%#sutf8'10] a = b)

function tail_concat_char [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/utf8.rs" 57 0 57 43] (a: Seq.seq Char.t) (b: Seq.seq Char.t) : ()
 = [%#sutf8'7] let _ = bytes_extensional_char (tail_char (Seq.(++) a b)) (Seq.(++) (tail_char a) b) in ()

axiom tail_concat_char_spec: forall a: Seq.seq Char.t, b: Seq.seq Char.t. ([%#sutf8'5] gt_log_Int (Seq.length a) 0)
    -> ([%#sutf8'6] tail_char (Seq.(++) a b) = Seq.(++) (tail_char a) b)

function encoding_concat [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/utf8.rs" 101 0 101 50] (a: Seq.seq Char.t) (b: Seq.seq Char.t) : ()

axiom encoding_concat_def: forall a: Seq.seq Char.t, b: Seq.seq Char.t [encoding_concat a b]. encoding_concat a b
    = ([%#sutf8'4] if gt_log_Int (Seq.length a) 0 then
      let _ = encoding_concat (tail_char a) b in let _ = concat_assoc_u8 (to_utf8_char (Seq.get a 0)) (to_bytes (tail_char a)) (to_bytes b) in let _ = tail_concat_char a b in ()
    else
      ()
    )

axiom encoding_concat_spec: forall a: Seq.seq Char.t, b: Seq.seq Char.t. [%#sutf8'1] to_bytes (Seq.(++) a b)
    = Seq.(++) (to_bytes a) (to_bytes b)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant a : Seq.seq UInt8.t

constant b : Seq.seq UInt8.t

function valid_concat [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/utf8.rs" 114 0 114 43] (a: Seq.seq UInt8.t) (b: Seq.seq UInt8.t) : ()

goal vc_valid_concat: ([%#sutf8] valid a /\ valid b)
  -> ([@stop_split] [@expl:such_that requires] [%#slogic] exists x: Seq.seq Char.t. index_Mapping_Seq_char_bool (fun (ca: Seq.seq Char.t) -> to_bytes ca
      = a) x)
  /\ (([@stop_split] [@expl:such_that ensures] [%#slogic'0] index_Mapping_Seq_char_bool (fun (ca: Seq.seq Char.t) -> to_bytes ca
    = a) (such_that_Seq_char (fun (ca: Seq.seq Char.t) -> to_bytes ca = a)))
  -> (let ca = such_that_Seq_char (fun (ca: Seq.seq Char.t) -> to_bytes ca
  = a) in ([@stop_split] [@expl:such_that requires] [%#slogic] exists x: Seq.seq Char.t. index_Mapping_Seq_char_bool (fun (cb: Seq.seq Char.t) -> to_bytes cb
      = b) x)
  /\ (([@stop_split] [@expl:such_that ensures] [%#slogic'0] index_Mapping_Seq_char_bool (fun (cb: Seq.seq Char.t) -> to_bytes cb
    = b) (such_that_Seq_char (fun (cb: Seq.seq Char.t) -> to_bytes cb = b)))
  -> (let cb = such_that_Seq_char (fun (cb: Seq.seq Char.t) -> to_bytes cb
  = b) in ([@stop_split] [@expl:encoding_concat ensures] [%#sutf8'1] to_bytes (Seq.(++) ca cb)
    = Seq.(++) (to_bytes ca) (to_bytes cb))
  -> (let _ = encoding_concat ca cb in [@stop_split] [@expl:valid_concat ensures] [%#sutf8'0] valid (Seq.(++) a b))))))
