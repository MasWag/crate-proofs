use creusot.int.UInt8
use seq.Seq
use int.Int

function tail_u8 (self: Seq.seq UInt8.t) : Seq.seq UInt8.t = [%#sseq] Seq.([..]) self 1 (Seq.length self)

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant input : Seq.seq UInt8.t

constant output : Seq.seq UInt8.t

predicate ascii_erasure [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/utf8.rs" 123 0 123 61] (input: Seq.seq UInt8.t) (output: Seq.seq UInt8.t)

goal vc_ascii_erasure: if Seq.length input = 0 then
    true
  else
    if UInt8.t'int (Seq.get input 0) < 128 then
      ([@expl:variant decreases] well_founded_relation_Int ([%#sutf8] Seq.length input) ([%#sutf8] Seq.length (tail_u8 input)))
      /\ (if ascii_erasure (tail_u8 input) output then
        true
      else
        if gt_log_Int (Seq.length output) 0 then
          if Seq.get input 0 = Seq.get output 0 then
            [@expl:variant decreases] well_founded_relation_Int ([%#sutf8] Seq.length input) ([%#sutf8] Seq.length (tail_u8 input))
          else
            true
        
        else
          true
      
      )
    else
      if gt_log_Int (Seq.length output) 0 then
        if Seq.get input 0 = Seq.get output 0 then
          [@expl:variant decreases] well_founded_relation_Int ([%#sutf8] Seq.length input) ([%#sutf8] Seq.length (tail_u8 input))
        else
          true
      
      else
        true
    
  
  
