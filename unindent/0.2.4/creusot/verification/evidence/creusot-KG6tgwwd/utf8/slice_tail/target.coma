use creusot.int.UInt8
use seq.Seq
use int.Int

function tail_u8 (self: Seq.seq UInt8.t) : Seq.seq UInt8.t = [%#sseq] Seq.([..]) self 1 (Seq.length self)

function bytes_extensional_u8 [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/utf8.rs" 40 0 40 49] (a: Seq.seq UInt8.t) (b: Seq.seq UInt8.t) : ()
 = [%#sutf8'5] ()

axiom bytes_extensional_u8_spec: forall a: Seq.seq UInt8.t, b: Seq.seq UInt8.t. ([%#sutf8'2] Seq.length a
      = Seq.length b)
    -> ([%#sutf8'3] forall i: int. 0 <= i /\ i < Seq.length a -> Seq.get a i = Seq.get b i) -> ([%#sutf8'4] a = b)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant s : Seq.seq UInt8.t

constant n : int

function slice_tail [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/utf8.rs" 67 0 67 37] (s: Seq.seq UInt8.t) (n: int) : ()

goal vc_slice_tail: ([%#sutf8] 0 < n /\ n <= Seq.length s)
  -> (let a = tail_u8 (Seq.([..]) s 0 n) in let b = Seq.([..]) (tail_u8 s) 0 (n - 1) in (forall i: int. 0 <= i
        /\ i < Seq.length a -> Seq.get a i = Seq.get b i)
  && ([@stop_split] [@expl:bytes_extensional requires] ([@stop_split] [@expl:bytes_extensional requires #0] [%#sutf8'2] Seq.length a
      = Seq.length b)
    /\ ([@stop_split] [@expl:bytes_extensional requires #1] [%#sutf8'3] forall i: int. 0 <= i /\ i < Seq.length a
      -> Seq.get a i = Seq.get b i))
  /\ (([@stop_split] [@expl:bytes_extensional ensures] [%#sutf8'4] a = b)
  -> (let _ = bytes_extensional_u8 a b in let a'0 = Seq.([..]) (tail_u8 s) (n
  - 1) (Seq.length (tail_u8 s)) in let b'0 = Seq.([..]) s n (Seq.length s) in (forall i: int. 0 <= i
        /\ i < Seq.length a'0 -> Seq.get a'0 i = Seq.get b'0 i)
  && ([@stop_split] [@expl:bytes_extensional requires] ([@stop_split] [@expl:bytes_extensional requires #0] [%#sutf8'2] Seq.length a'0
      = Seq.length b'0)
    /\ ([@stop_split] [@expl:bytes_extensional requires #1] [%#sutf8'3] forall i: int. 0 <= i /\ i < Seq.length a'0
      -> Seq.get a'0 i = Seq.get b'0 i))
  /\ (([@stop_split] [@expl:bytes_extensional ensures] [%#sutf8'4] a'0 = b'0)
  -> (let _ = bytes_extensional_u8 a'0 b'0 in [@stop_split] [@expl:slice_tail ensures] ([@stop_split] [@expl:slice_tail ensures #0] [%#sutf8'0] tail_u8 (Seq.([..]) s 0 n)
    = Seq.([..]) (tail_u8 s) 0 (n - 1))
  /\ ([@stop_split] [@expl:slice_tail ensures #1] [%#sutf8'1] Seq.([..]) (tail_u8 s) (n - 1) (Seq.length (tail_u8 s))
  = Seq.([..]) s n (Seq.length s)))))))
