use creusot.int.UInt8
use seq.Seq
use int.Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

function tail_u8 (self: Seq.seq UInt8.t) : Seq.seq UInt8.t = [%#sseq] Seq.([..]) self 1 (Seq.length self)

function bytes_extensional_u8 [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/utf8.rs" 40 0 40 49] (a: Seq.seq UInt8.t) (b: Seq.seq UInt8.t) : ()
 = [%#sutf8'4] ()

axiom bytes_extensional_u8_spec: forall a: Seq.seq UInt8.t, b: Seq.seq UInt8.t. ([%#sutf8'1] Seq.length a
      = Seq.length b)
    -> ([%#sutf8'2] forall i: int. 0 <= i /\ i < Seq.length a -> Seq.get a i = Seq.get b i) -> ([%#sutf8'3] a = b)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant s : Seq.seq UInt8.t

function bytes_head_tail [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/utf8.rs" 45 0 45 34] (s: Seq.seq UInt8.t) : ()

goal vc_bytes_head_tail: ([%#sutf8] gt_log_Int (Seq.length s) 0)
  -> (let joined = Seq.(++) (Seq.singleton (Seq.get s 0)) (tail_u8 s) in Seq.get joined 0 = Seq.get s 0
  && (forall i: int. 1 <= i /\ i < Seq.length s -> Seq.get (tail_u8 s) (i - 1) = Seq.get s i)
  && (forall i: int. 1 <= i /\ i < Seq.length s -> Seq.get joined i = Seq.get (tail_u8 s) (i - 1))
  && (forall i: int. 0 <= i /\ i < Seq.length s -> Seq.get joined i = Seq.get s i)
  && ([@stop_split] [@expl:bytes_extensional requires] ([@stop_split] [@expl:bytes_extensional requires #0] [%#sutf8'1] Seq.length joined
      = Seq.length s)
    /\ ([@stop_split] [@expl:bytes_extensional requires #1] [%#sutf8'2] forall i: int. 0 <= i /\ i < Seq.length joined
      -> Seq.get joined i = Seq.get s i))
  /\ (([@stop_split] [@expl:bytes_extensional ensures] [%#sutf8'3] joined = s)
  -> (let _ = bytes_extensional_u8 joined s in [@stop_split] [@expl:bytes_head_tail ensures] [%#sutf8'0] Seq.(++) (Seq.singleton (Seq.get s 0)) (tail_u8 s)
  = s)))
