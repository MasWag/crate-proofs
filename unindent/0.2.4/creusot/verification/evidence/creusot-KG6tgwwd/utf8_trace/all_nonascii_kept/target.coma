use creusot.int.UInt8
use seq.Seq
use map.Map
use int.Int

predicate white [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 5 0 5 27] (b: UInt8.t) =
  [%#sspec'5] b = (32: UInt8.t) \/ b = (9: UInt8.t)

predicate later_candidate [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 97 0 97 58] (s: Seq.seq UInt8.t) (a: int) (k: int) =
  [%#sspec'1] 0 < a
  /\ a <= k
  /\ k < Seq.length s
  /\ Seq.get s (a - 1) = (10: UInt8.t)
  /\ Seq.get s k <> (10: UInt8.t) /\ not white (Seq.get s k) /\ (forall j: int. a <= j /\ j < k -> white (Seq.get s j))

predicate source_margin [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 104 0 104 48] (s: Seq.seq UInt8.t) (m: int) =
  [%#sspec] 0 <= m
  /\ (m = 0 /\ (forall a: int, k: int. not later_candidate s a k)
  \/ (exists a: int, k: int. later_candidate s a k /\ m = k - a)
  /\ (forall a: int, k: int. later_candidate s a k -> m <= k - a))

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate initial_crlf [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 19 0 19 39] (s: Seq.seq UInt8.t) =
  [%#sspec'2] ge_log_Int (Seq.length s) 2 /\ Seq.get s 0 = (13: UInt8.t) /\ Seq.get s 1 = (10: UInt8.t)

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate ignore_first [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 29 0 29 55] (s: Seq.seq UInt8.t) (preserve: bool) =
  [%#sspec'3] not preserve /\ (gt_log_Int (Seq.length s) 0 /\ Seq.get s 0 = (10: UInt8.t) \/ initial_crlf s)

predicate source_line_start [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 112 0 112 60] (s: Seq.seq UInt8.t) (a: int) (i: int) =
  [%#sspec'4] 0 <= a
  /\ a <= i
  /\ i < Seq.length s
  /\ (a = 0 \/ Seq.get s (a - 1) = (10: UInt8.t)) /\ (forall j: int. a <= j /\ j < i -> Seq.get s j <> (10: UInt8.t))

predicate source_keep [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 121 0 121 70] (s: Seq.seq UInt8.t) (m: int) (preserve: bool) (i: int) =
  [%#sspec'0] 0 <= i
  /\ i < Seq.length s
  /\ not (i = 0 /\ initial_crlf s)
  /\ (if Seq.get s i = (10: UInt8.t) then
    not (ignore_first s preserve /\ (i = 0 \/ i = 1 /\ initial_crlf s))
  else
    exists a: int. source_line_start s a i /\ (a = 0 \/ m <= i - a)
  )

predicate index_Mapping_Int_bool [@inline:trivial] (self: Map.map int bool) (a: int) = [%#smapping] Map.get self a

meta "rewrite_def" predicate index_Mapping_Int_bool

function such_that_Int (p: Map.map int bool) : int

axiom such_that_Int_spec:
  forall p: Map.map int bool [such_that_Int p]. ([%#slogic] exists x: int. index_Mapping_Int_bool p x)
    -> ([%#slogic'0] index_Mapping_Int_bool p (such_that_Int p))

