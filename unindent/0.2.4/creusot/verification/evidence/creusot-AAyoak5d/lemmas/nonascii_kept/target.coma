use creusot.int.UInt8
use seq.Seq
use int.Int

predicate white [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 5 0 5 27] (b: UInt8.t) =
  [%#sspec'2] b = (32: UInt8.t) \/ b = (9: UInt8.t)

predicate later_candidate [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 97 0 97 58] (s: Seq.seq UInt8.t) (a: int) (k: int) =
  [%#sspec'3] 0 < a
  /\ a <= k
  /\ k < Seq.length s
  /\ Seq.get s (a - 1) = (10: UInt8.t)
  /\ Seq.get s k <> (10: UInt8.t) /\ not white (Seq.get s k) /\ (forall j: int. a <= j /\ j < k -> white (Seq.get s j))

predicate source_margin [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 104 0 104 48] (s: Seq.seq UInt8.t) (m: int) =
  [%#sspec] 0 <= m
  /\ (m = 0 /\ (forall a: int, k: int. not later_candidate s a k)
  \/ (exists a: int, k: int. later_candidate s a k /\ m = k - a)
  /\ (forall a: int, k: int. later_candidate s a k -> m <= k - a))

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate initial_crlf [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 19 0 19 39] (s: Seq.seq UInt8.t) =
  [%#sspec'4] ge_log_Int (Seq.length s) 2 /\ Seq.get s 0 = (13: UInt8.t) /\ Seq.get s 1 = (10: UInt8.t)

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate ignore_first [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 29 0 29 55] (s: Seq.seq UInt8.t) (preserve: bool) =
  [%#sspec'5] not preserve /\ (gt_log_Int (Seq.length s) 0 /\ Seq.get s 0 = (10: UInt8.t) \/ initial_crlf s)

predicate source_line_start [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 112 0 112 60] (s: Seq.seq UInt8.t) (a: int) (i: int) =
  [%#sspec'1] 0 <= a
  /\ a <= i
  /\ i < Seq.length s
  /\ (a = 0 \/ Seq.get s (a - 1) = (10: UInt8.t)) /\ (forall j: int. a <= j /\ j < i -> Seq.get s j <> (10: UInt8.t))

predicate source_keep [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 121 0 121 70] (s: Seq.seq UInt8.t) (m: int) (preserve: bool) (i: int) =
  [%#sspec'0] 0 <= i
  /\ i < Seq.length s
  /\ not (i = 0 /\ initial_crlf s)
  /\ (if Seq.get s i = (10: UInt8.t) then
    not (ignore_first s preserve /\ (i = 0 \/ i = 1 /\ initial_crlf s))
  else
    exists a: int. source_line_start s a i /\ (a = 0 \/ m <= i - a)
  )

function find_start [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/lemmas.rs" 36 0 36 48] (s: Seq.seq UInt8.t) (i: int) (at': int) : int

axiom find_start_def: forall s: Seq.seq UInt8.t, i: int, at': int [find_start s i at']. ([%#slemmas'3] 0 <= at'
      /\ at' <= i /\ i < Seq.length s)
    -> ([%#slemmas'4] forall j: int. at' <= j /\ j < i -> Seq.get s j <> (10: UInt8.t))
    -> find_start s i at'
    = ([%#slemmas'14] if at' = 0 \/ Seq.get s (at' - 1) = (10: UInt8.t) then at' else find_start s i (at' - 1))

axiom find_start_spec: forall s: Seq.seq UInt8.t, i: int, at': int [find_start s i at']. ([%#slemmas'3] 0 <= at'
      /\ at' <= i /\ i < Seq.length s)
    -> ([%#slemmas'4] forall j: int. at' <= j /\ j < i -> Seq.get s j <> (10: UInt8.t))
    -> ([%#slemmas'5] source_line_start s (find_start s i at') i)

function first_nonwhite [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/lemmas.rs" 27 0 27 60] (s: Seq.seq UInt8.t) (a: int) (at': int) (end': int) : int

axiom first_nonwhite_def:
  forall s: Seq.seq UInt8.t, a: int, at': int, end': int [first_nonwhite s a at' end']. ([%#slemmas'6] 0 < a
      /\ a <= at' /\ at' <= end' /\ end' < Seq.length s)
    -> ([%#slemmas'7] Seq.get s (a - 1) = (10: UInt8.t))
    -> ([%#slemmas'8] forall j: int. a <= j /\ j < at' -> white (Seq.get s j))
    -> ([%#slemmas'9] forall j: int. a <= j /\ j <= end' -> Seq.get s j <> (10: UInt8.t))
    -> ([%#slemmas'10] not white (Seq.get s end'))
    -> first_nonwhite s a at' end'
    = ([%#slemmas'16] if white (Seq.get s at') then first_nonwhite s a (at' + 1) end' else at')

axiom first_nonwhite_spec:
  forall s: Seq.seq UInt8.t, a: int, at': int, end': int [first_nonwhite s a at' end']. ([%#slemmas'6] 0 < a
      /\ a <= at' /\ at' <= end' /\ end' < Seq.length s)
    -> ([%#slemmas'7] Seq.get s (a - 1) = (10: UInt8.t))
    -> ([%#slemmas'8] forall j: int. a <= j /\ j < at' -> white (Seq.get s j))
    -> ([%#slemmas'9] forall j: int. a <= j /\ j <= end' -> Seq.get s j <> (10: UInt8.t))
    -> ([%#slemmas'10] not white (Seq.get s end')) -> ([%#slemmas'11] later_candidate s a (first_nonwhite s a at' end'))

axiom first_nonwhite_spec'0:
  forall s: Seq.seq UInt8.t, a: int, at': int, end': int [first_nonwhite s a at' end']. ([%#slemmas'6] 0 < a
      /\ a <= at' /\ at' <= end' /\ end' < Seq.length s)
    -> ([%#slemmas'7] Seq.get s (a - 1) = (10: UInt8.t))
    -> ([%#slemmas'8] forall j: int. a <= j /\ j < at' -> white (Seq.get s j))
    -> ([%#slemmas'9] forall j: int. a <= j /\ j <= end' -> Seq.get s j <> (10: UInt8.t))
    -> ([%#slemmas'10] not white (Seq.get s end'))
    -> ([%#slemmas'12] a <= first_nonwhite s a at' end' /\ first_nonwhite s a at' end' <= end')

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant s : Seq.seq UInt8.t

constant m : int

constant p : bool

constant i : int

function nonascii_kept [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/lemmas.rs" 45 0 45 50] (s: Seq.seq UInt8.t) (m: int) (p: bool) (i: int) : ()

goal vc_nonascii_kept: ([%#slemmas] source_margin s m)
  -> ([%#slemmas'0] 0 <= i /\ i < Seq.length s)
  -> ([%#slemmas'1] ge_log_Int (UInt8.t'int (Seq.get s i)) 128)
  -> ([@stop_split] [@expl:find_start requires] ([@stop_split] [@expl:find_start requires #0] [%#slemmas'3] 0 <= i
      /\ i <= i /\ i < Seq.length s)
    /\ ([@stop_split] [@expl:find_start requires #1] [%#slemmas'4] forall j: int. i <= j /\ j < i
      -> Seq.get s j <> (10: UInt8.t)))
  /\ (([@stop_split] [@expl:find_start ensures] [%#slemmas'5] source_line_start s (find_start s i i) i)
  -> (let a = find_start s i i in if gt_log_Int a 0 then
    ([@stop_split] [@expl:first_nonwhite requires] ([@stop_split] [@expl:first_nonwhite requires #0] [%#slemmas'6] 0 < a
        /\ a <= a /\ a <= i /\ i < Seq.length s)
      /\ ([@stop_split] [@expl:first_nonwhite requires #1] [%#slemmas'7] Seq.get s (a - 1) = (10: UInt8.t))
      /\ ([@stop_split] [@expl:first_nonwhite requires #2] [%#slemmas'8] forall j: int. a <= j /\ j < a
          -> white (Seq.get s j))
      /\ ([@stop_split] [@expl:first_nonwhite requires #3] [%#slemmas'9] forall j: int. a <= j /\ j <= i
          -> Seq.get s j <> (10: UInt8.t))
      /\ ([@stop_split] [@expl:first_nonwhite requires #4] [%#slemmas'10] not white (Seq.get s i)))
    /\ (([@stop_split] [@expl:first_nonwhite ensures] ([@stop_split] [@expl:first_nonwhite ensures #0] [%#slemmas'11] later_candidate s a (first_nonwhite s a a i))
      /\ ([@stop_split] [@expl:first_nonwhite ensures #1] [%#slemmas'12] a <= first_nonwhite s a a i
      /\ first_nonwhite s a a i <= i))
    -> (let k = first_nonwhite s a a i in [@stop_split] [@expl:nonascii_kept ensures] [%#slemmas'2] source_keep s m p i))
  else
    [@stop_split] [@expl:nonascii_kept ensures] [%#slemmas'2] source_keep s m p i
  ))
