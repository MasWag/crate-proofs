use creusot.slice.Slice64
use creusot.int.UInt8
use creusot.int.UInt64
use seq.Seq
use creusot.prelude.MutBorrow
use creusot.prelude.Any
use int.Int

let len_u8 (self_: Slice64.slice UInt8.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

predicate white [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 5 0 5 27] (b: UInt8.t) =
  [%#sspec'8] b = (32: UInt8.t) \/ b = (9: UInt8.t)

predicate later_candidate [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 97 0 97 58] (s: Seq.seq UInt8.t) (a: int) (k: int) =
  [%#sspec'5] 0 < a
  /\ a <= k
  /\ k < Seq.length s
  /\ Seq.get s (a - 1) = (10: UInt8.t)
  /\ Seq.get s k <> (10: UInt8.t) /\ not white (Seq.get s k) /\ (forall j: int. a <= j /\ j < k -> white (Seq.get s j))

predicate source_margin [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 104 0 104 48] (s: Seq.seq UInt8.t) (m: int) =
  [%#sspec] 0 <= m
  /\ (m = 0 /\ (forall a: int, k: int. not later_candidate s a k)
  \/ (exists a: int, k: int. later_candidate s a k /\ m = k - a)
  /\ (forall a: int, k: int. later_candidate s a k -> m <= k - a))

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate minimum_prefix [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/lib.rs" 52 0 52 79] (s: Seq.seq UInt8.t) (bound: int) (found: bool) (margin: int) =
  [%#slib'63] ge_log_Int margin 0
  /\ found = (exists a: int, k: int. a < bound /\ later_candidate s a k)
  /\ (not found -> margin = 0)
  /\ (found -> (exists a: int, k: int. a < bound /\ later_candidate s a k /\ k - a = margin))
  /\ (forall a: int, k: int. a < bound /\ later_candidate s a k -> margin <= k - a)

let common_margin (s: Slice64.slice UInt8.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:common_margin ensures] ([@stop_split] [@expl:common_margin ensures #0] [%#slib'61] source_margin (Slice64.view s) (UInt64.t'int result))
    /\ ([@stop_split] [@expl:common_margin ensures #1] [%#slib'62] minimum_prefix (Slice64.view s) (Seq.length (Slice64.view s)
    + 1) (UInt64.t'int result <> 0
    \/ (exists a: int, k: int. later_candidate (Slice64.view s) a k)) (UInt64.t'int result))}
    (! return {result}) ]

type t_Vec_u8_Global

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_u8_Global (self: t_Vec_u8_Global) : Seq.seq UInt8.t

axiom view_Vec_u8_Global_spec:
  forall self: t_Vec_u8_Global [view_Vec_u8_Global self]. [%#svec'0] Seq.length (view_Vec_u8_Global self)
    <= UInt64.t'int const_MAX

let with_capacity_u8 (capacity: UInt64.t) (return (x: t_Vec_u8_Global)) = any
  [ return (result: t_Vec_u8_Global) ->
  {[@stop_split] [@expl:with_capacity ensures] [%#svec] Seq.length (view_Vec_u8_Global result) = 0}
    (! return {result}) ]

let new_Int (return (x: Seq.seq int)) = any
  [ return (result: Seq.seq int) -> {[@stop_split] [@expl:new ensures] [%#sseq] result = (Seq.empty: Seq.seq int)}
    (! return {result}) ]

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

predicate initial_crlf [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 19 0 19 39] (s: Seq.seq UInt8.t) =
  [%#sspec'6] ge_log_Int (Seq.length s) 2 /\ Seq.get s 0 = (13: UInt8.t) /\ Seq.get s 1 = (10: UInt8.t)

predicate ignore_first [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 29 0 29 55] (s: Seq.seq UInt8.t) (preserve: bool) =
  [%#sspec'7] not preserve /\ (gt_log_Int (Seq.length s) 0 /\ Seq.get s 0 = (10: UInt8.t) \/ initial_crlf s)

predicate source_line_start [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 112 0 112 60] (s: Seq.seq UInt8.t) (a: int) (i: int) =
  [%#sspec'1] 0 <= a
  /\ a <= i
  /\ i < Seq.length s
  /\ (a = 0 \/ Seq.get s (a - 1) = (10: UInt8.t)) /\ (forall j: int. a <= j /\ j < i -> Seq.get s j <> (10: UInt8.t))

predicate source_keep [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 121 0 121 70] (s: Seq.seq UInt8.t) (m: int) (preserve: bool) (i: int) =
  [%#sspec'2] 0 <= i
  /\ i < Seq.length s
  /\ not (i = 0 /\ initial_crlf s)
  /\ (if Seq.get s i = (10: UInt8.t) then
    not (ignore_first s preserve /\ (i = 0 \/ i = 1 /\ initial_crlf s))
  else
    exists a: int. source_line_start s a i /\ (a = 0 \/ m <= i - a)
  )

predicate selection_trace [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 135 0 138 9] (s: Seq.seq UInt8.t) (m: int) (preserve: bool) (bound: int) (positions: Seq.seq int) (out: Seq.seq UInt8.t) =
  [%#sspec'0] 0 <= bound
  /\ bound <= Seq.length s
  /\ Seq.length out = Seq.length positions
  /\ (forall j: int. 0 <= j /\ j < Seq.length positions
      -> 0 <= Seq.get positions j
      /\ Seq.get positions j < bound
      /\ source_keep s m preserve (Seq.get positions j) /\ Seq.get out j = Seq.get s (Seq.get positions j))
  /\ (forall j: int, k: int. 0 <= j /\ j < k /\ k < Seq.length positions -> Seq.get positions j < Seq.get positions k)
  /\ (forall i: int. 0 <= i /\ i < bound /\ source_keep s m preserve i
    -> (exists j: int. 0 <= j /\ j < Seq.length positions /\ Seq.get positions j = i))

function trace_keep [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/lemmas.rs" 9 0 9 82] (s: Seq.seq UInt8.t) (m: int) (p: bool) (bound: int) (positions: Seq.seq int) (out: Seq.seq UInt8.t) : ()

axiom trace_keep_spec:
  forall s: Seq.seq UInt8.t, m: int, p: bool, bound: int, positions: Seq.seq int, out: Seq.seq UInt8.t. ([%#slemmas] selection_trace s m p bound positions out)
    -> ([%#slemmas'0] bound < Seq.length s)
    -> ([%#slemmas'1] source_keep s m p bound)
    -> ([%#slemmas'2] selection_trace s m p (bound + 1) (Seq.snoc positions bound) (Seq.snoc out (Seq.get s bound)))

let push_u8 (self_: MutBorrow.t t_Vec_u8_Global) (v: UInt8.t) (return (x: ())) = any
  [ return (result: ()) -> {[@stop_split] [@expl:push ensures] [%#svec'1] view_Vec_u8_Global self_.final
    = Seq.snoc (view_Vec_u8_Global self_.current) v}
    (! return {result}) ]

let into_ghost_Int (self: int) (return (x: int)) = any
  [ return (result: int) -> {[@stop_split] [@expl:into_ghost ensures] [%#ssnapshot] result = self} (! return {result}) ]

let deref_mut_Ghost_Seq_Int (self: MutBorrow.t (Seq.seq int)) (return (x: MutBorrow.t (Seq.seq int))) = any
  [ return (result: MutBorrow.t (Seq.seq int)) -> {[@stop_split] [@expl:deref_mut ensures] [%#sghost] result = self}
    (! return {result}) ]

let deref_Ghost_Int (self: int) (return (x: int)) = any
