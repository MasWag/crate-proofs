use creusot.slice.Slice64
use creusot.int.UInt8
use seq.Seq
use creusot.int.UInt64
use creusot.prelude.Any
use int.Int

type t_Vec_u8_Global

predicate white [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 5 0 5 27] (b: UInt8.t) =
  [%#sspec'4] b = (32: UInt8.t) \/ b = (9: UInt8.t)

predicate later_candidate [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 97 0 97 58] (s: Seq.seq UInt8.t) (a: int) (k: int) =
  [%#sspec'2] 0 < a
  /\ a <= k
  /\ k < Seq.length s
  /\ Seq.get s (a - 1) = (10: UInt8.t)
  /\ Seq.get s k <> (10: UInt8.t) /\ not white (Seq.get s k) /\ (forall j: int. a <= j /\ j < k -> white (Seq.get s j))

predicate source_margin [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 104 0 104 48] (s: Seq.seq UInt8.t) (m: int) =
  [%#sspec'0] 0 <= m
  /\ (m = 0 /\ (forall a: int, k: int. not later_candidate s a k)
  \/ (exists a: int, k: int. later_candidate s a k /\ m = k - a)
  /\ (forall a: int, k: int. later_candidate s a k -> m <= k - a))

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate initial_crlf [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 19 0 19 39] (s: Seq.seq UInt8.t) =
  [%#sspec'6] ge_log_Int (Seq.length s) 2 /\ Seq.get s 0 = (13: UInt8.t) /\ Seq.get s 1 = (10: UInt8.t)

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate ignore_first [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 29 0 29 55] (s: Seq.seq UInt8.t) (preserve: bool) =
  [%#sspec'7] not preserve /\ (gt_log_Int (Seq.length s) 0 /\ Seq.get s 0 = (10: UInt8.t) \/ initial_crlf s)

predicate source_line_start [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 112 0 112 60] (s: Seq.seq UInt8.t) (a: int) (i: int) =
  [%#sspec'8] 0 <= a
  /\ a <= i
  /\ i < Seq.length s
  /\ (a = 0 \/ Seq.get s (a - 1) = (10: UInt8.t)) /\ (forall j: int. a <= j /\ j < i -> Seq.get s j <> (10: UInt8.t))

predicate source_keep [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 121 0 121 70] (s: Seq.seq UInt8.t) (m: int) (preserve: bool) (i: int) =
  [%#sspec'5] 0 <= i
  /\ i < Seq.length s
  /\ not (i = 0 /\ initial_crlf s)
  /\ (if Seq.get s i = (10: UInt8.t) then
    not (ignore_first s preserve /\ (i = 0 \/ i = 1 /\ initial_crlf s))
  else
    exists a: int. source_line_start s a i /\ (a = 0 \/ m <= i - a)
  )

predicate selection_trace [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 135 0 138 9] (s: Seq.seq UInt8.t) (m: int) (preserve: bool) (bound: int) (positions: Seq.seq int) (out: Seq.seq UInt8.t) =
  [%#sspec'3] 0 <= bound
  /\ bound <= Seq.length s
  /\ Seq.length out = Seq.length positions
  /\ (forall j: int. 0 <= j /\ j < Seq.length positions
      -> 0 <= Seq.get positions j
      /\ Seq.get positions j < bound
      /\ source_keep s m preserve (Seq.get positions j) /\ Seq.get out j = Seq.get s (Seq.get positions j))
  /\ (forall j: int, k: int. 0 <= j /\ j < k /\ k < Seq.length positions -> Seq.get positions j < Seq.get positions k)
  /\ (forall i: int. 0 <= i /\ i < bound /\ source_keep s m preserve i
    -> (exists j: int. 0 <= j /\ j < Seq.length positions /\ Seq.get positions j = i))

predicate selected_prefix [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 150 0 150 92] (s: Seq.seq UInt8.t) (m: int) (preserve: bool) (bound: int) (out: Seq.seq UInt8.t) =
  [%#sspec'1] exists positions: Seq.seq int. selection_trace s m preserve bound positions out

predicate source_unindented [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 156 0 156 74] (s: Seq.seq UInt8.t) (preserve: bool) (out: Seq.seq UInt8.t) =
  [%#sspec] exists m: int. source_margin s m /\ selected_prefix s m preserve (Seq.length s) out

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_u8_Global (self: t_Vec_u8_Global) : Seq.seq UInt8.t

axiom view_Vec_u8_Global_spec:
  forall self: t_Vec_u8_Global [view_Vec_u8_Global self]. [%#svec] Seq.length (view_Vec_u8_Global self)
    <= UInt64.t'int const_MAX

let unindent_bytes (s: Slice64.slice UInt8.t) (return (x: t_Vec_u8_Global)) = any
  [ return (result: t_Vec_u8_Global) ->
  {[@stop_split] [@expl:unindent_bytes ensures] ([@stop_split] [@expl:unindent_bytes ensures #0] [%#slib'2] source_unindented (Slice64.view s) false (view_Vec_u8_Global result))
    /\ ([@stop_split] [@expl:unindent_bytes ensures #1] [%#slib'3] Seq.length (view_Vec_u8_Global result)
    <= Seq.length (Slice64.view s))}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let unindent_slice_u8 [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/lib.rs" 149 4 149 38]
  (self: Slice64.slice UInt8.t) (return (x: t_Vec_u8_Global)) = (! bb0
  [ bb0 = s0
    [ s0 = unindent_bytes [%#slib] {self} (fun (_x: t_Vec_u8_Global) -> [ &_ret <- _x ] s1) | s1 = return {_ret} ] ]
  [ & _ret: t_Vec_u8_Global = Any.any_l () | & self: Slice64.slice UInt8.t = self ])
  [ return (result: t_Vec_u8_Global) ->
  {[@stop_split] [@expl:unindent_slice_u8 ensures] ([@stop_split] [@expl:unindent ensures #0] [%#slib'0] source_unindented (Slice64.view self) false (view_Vec_u8_Global result))
    /\ ([@stop_split] [@expl:unindent ensures #1] [%#slib'1] Seq.length (view_Vec_u8_Global result)
    <= Seq.length (Slice64.view self))}
    (! return {result}) ]
