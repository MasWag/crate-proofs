use creusot.slice.Slice64
use creusot.int.UInt8
use creusot.prelude.Char
use seq.Seq
use map.Map
use creusot.int.UInt64
use creusot.prelude.Any
use int.Int

function tail_char (self: Seq.seq Char.t) : Seq.seq Char.t = [%#sseq'1] Seq.([..]) self 1 (Seq.length self)

function flat_map_char (self: Seq.seq Char.t) (other: Map.map Char.t (Seq.seq UInt8.t)) : Seq.seq UInt8.t

axiom flat_map_char_def:
  forall self: Seq.seq Char.t, other: Map.map Char.t (Seq.seq UInt8.t) [flat_map_char self other]. flat_map_char self other
    = ([%#sseq'0] if Seq.length self = 0 then
      Seq.empty: Seq.seq UInt8.t
    else
      Seq.(++) (Map.get other (Seq.get self 0)) (flat_map_char (tail_char self) other)
    )

function to_utf8_char (self: Char.t) : Seq.seq UInt8.t

axiom to_utf8_char_spec: forall self: Char.t [to_utf8_char self]. [%#schar] 1 <= Seq.length (to_utf8_char self)
    /\ Seq.length (to_utf8_char self) <= 4

function to_bytes (self: Seq.seq Char.t) : Seq.seq UInt8.t =
  [%#sstring] flat_map_char self (fun (c: Char.t) -> to_utf8_char c)

function view_str (self: string) : Seq.seq Char.t

let as_bytes (self_: string) (return (x: Slice64.slice UInt8.t)) = any
  [ return (result: Slice64.slice UInt8.t) -> {[@stop_split] [@expl:as_bytes ensures] [%#sutf8] Slice64.view result
    = to_bytes (view_str self_)}
    (! return {result}) ]

type t_Vec_u8_Global

predicate white [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 5 0 5 27] (b: UInt8.t) =
  [%#sspec'4] b = (32: UInt8.t) \/ b = (9: UInt8.t)

predicate later_candidate [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 97 0 97 58] (s: Seq.seq UInt8.t) (a: int) (k: int) =
  [%#sspec'2] 0 < a
  /\ a <= k
  /\ k < Seq.length s
  /\ Seq.get s (a - 1) = (10: UInt8.t)
  /\ Seq.get s k <> (10: UInt8.t) /\ not white (Seq.get s k) /\ (forall j: int. a <= j /\ j < k -> white (Seq.get s j))

predicate source_margin [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 104 0 104 48] (s: Seq.seq UInt8.t) (m: int) =
  [%#sspec'0] 0 <= m
  /\ (m = 0 /\ (forall a: int, k: int. not later_candidate s a k)
  \/ (exists a: int, k: int. later_candidate s a k /\ m = k - a)
  /\ (forall a: int, k: int. later_candidate s a k -> m <= k - a))

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate initial_crlf [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 19 0 19 39] (s: Seq.seq UInt8.t) =
  [%#sspec'6] ge_log_Int (Seq.length s) 2 /\ Seq.get s 0 = (13: UInt8.t) /\ Seq.get s 1 = (10: UInt8.t)

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

predicate ignore_first [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 29 0 29 55] (s: Seq.seq UInt8.t) (preserve: bool) =
  [%#sspec'7] not preserve /\ (gt_log_Int (Seq.length s) 0 /\ Seq.get s 0 = (10: UInt8.t) \/ initial_crlf s)

predicate source_line_start [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 112 0 112 60] (s: Seq.seq UInt8.t) (a: int) (i: int) =
  [%#sspec'8] 0 <= a
  /\ a <= i
  /\ i < Seq.length s
  /\ (a = 0 \/ Seq.get s (a - 1) = (10: UInt8.t)) /\ (forall j: int. a <= j /\ j < i -> Seq.get s j <> (10: UInt8.t))

predicate source_keep [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 121 0 121 70] (s: Seq.seq UInt8.t) (m: int) (preserve: bool) (i: int) =
  [%#sspec'5] 0 <= i
  /\ i < Seq.length s
  /\ not (i = 0 /\ initial_crlf s)
  /\ (if Seq.get s i = (10: UInt8.t) then
    not (ignore_first s preserve /\ (i = 0 \/ i = 1 /\ initial_crlf s))
  else
    exists a: int. source_line_start s a i /\ (a = 0 \/ m <= i - a)
  )

predicate selection_trace [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 135 0 138 9] (s: Seq.seq UInt8.t) (m: int) (preserve: bool) (bound: int) (positions: Seq.seq int) (out: Seq.seq UInt8.t) =
  [%#sspec'3] 0 <= bound
  /\ bound <= Seq.length s
  /\ Seq.length out = Seq.length positions
  /\ (forall j: int. 0 <= j /\ j < Seq.length positions
      -> 0 <= Seq.get positions j
      /\ Seq.get positions j < bound
      /\ source_keep s m preserve (Seq.get positions j) /\ Seq.get out j = Seq.get s (Seq.get positions j))
  /\ (forall j: int, k: int. 0 <= j /\ j < k /\ k < Seq.length positions -> Seq.get positions j < Seq.get positions k)
  /\ (forall i: int. 0 <= i /\ i < bound /\ source_keep s m preserve i
    -> (exists j: int. 0 <= j /\ j < Seq.length positions /\ Seq.get positions j = i))

predicate selected_prefix [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 150 0 150 92] (s: Seq.seq UInt8.t) (m: int) (preserve: bool) (bound: int) (out: Seq.seq UInt8.t) =
  [%#sspec'1] exists positions: Seq.seq int. selection_trace s m preserve bound positions out

predicate source_unindented [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 156 0 156 74] (s: Seq.seq UInt8.t) (preserve: bool) (out: Seq.seq UInt8.t) =
  [%#sspec] exists m: int. source_margin s m /\ selected_prefix s m preserve (Seq.length s) out

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_u8_Global (self: t_Vec_u8_Global) : Seq.seq UInt8.t

axiom view_Vec_u8_Global_spec:
  forall self: t_Vec_u8_Global [view_Vec_u8_Global self]. [%#svec] Seq.length (view_Vec_u8_Global self)
    <= UInt64.t'int const_MAX

let do_unindent_bytes (s: Slice64.slice UInt8.t) (preserve: bool) (return (x: t_Vec_u8_Global)) = any
  [ return (result: t_Vec_u8_Global) ->
  {[@stop_split] [@expl:do_unindent_bytes ensures] ([@stop_split] [@expl:do_unindent_bytes ensures #0] [%#slib'9] source_unindented (Slice64.view s) preserve (view_Vec_u8_Global result))
    /\ ([@stop_split] [@expl:do_unindent_bytes ensures #1] [%#slib'10] Seq.length (view_Vec_u8_Global result)
    <= Seq.length (Slice64.view s))}
    (! return {result}) ]

function tail_u8 (self: Seq.seq UInt8.t) : Seq.seq UInt8.t = [%#sseq'1] Seq.([..]) self 1 (Seq.length self)

predicate ascii_erasure [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/utf8.rs" 123 0 123 61] (input: Seq.seq UInt8.t) (output: Seq.seq UInt8.t)

axiom ascii_erasure_def:
  forall input: Seq.seq UInt8.t, output: Seq.seq UInt8.t [ascii_erasure input output]. ascii_erasure input output
    = ([%#sutf8'5] if Seq.length input = 0 then
      Seq.length output = 0
    else
      UInt8.t'int (Seq.get input 0) < 128 /\ ascii_erasure (tail_u8 input) output
      \/ gt_log_Int (Seq.length output) 0
      /\ Seq.get input 0 = Seq.get output 0 /\ ascii_erasure (tail_u8 input) (tail_u8 output)
    )

function source_erasure [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/utf8_trace.rs" 68 0 68 71] (source: Seq.seq UInt8.t) (preserve: bool) (output: Seq.seq UInt8.t) : ()

axiom source_erasure_spec:
  forall source: Seq.seq UInt8.t, preserve: bool, output: Seq.seq UInt8.t. ([%#sutf8_trace] source_unindented source preserve output)
    -> ([%#sutf8_trace'0] ascii_erasure source output)

predicate valid [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/utf8.rs" 6 0 6 36] (bytes: Seq.seq UInt8.t) =
  [%#sutf8'0] exists chars: Seq.seq Char.t. to_bytes chars = bytes

function valid_erasure [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/utf8.rs" 213 0 213 53] (input: Seq.seq UInt8.t) (output: Seq.seq UInt8.t) : ()

axiom valid_erasure_spec: forall input: Seq.seq UInt8.t, output: Seq.seq UInt8.t. ([%#sutf8'1] valid input
      /\ ascii_erasure input output) -> ([%#sutf8'2] valid output)

type t_String

type t_FromUtf8Error

type t_Result_String_FromUtf8Error = Ok t_String | Err t_FromUtf8Error

predicate inv_String (_1: t_String)

predicate inv_FromUtf8Error (_1: t_FromUtf8Error)

predicate inv_Result_String_FromUtf8Error (_1: t_Result_String_FromUtf8Error)

axiom inv_axiom [@rewrite]:
  forall x: t_Result_String_FromUtf8Error [inv_Result_String_FromUtf8Error x]. inv_Result_String_FromUtf8Error x
    = match x with
      | Ok f0 -> inv_String f0
      | Err f0 -> inv_FromUtf8Error f0
      end

function view_String (self: t_String) : Seq.seq Char.t

let from_utf8 (bytes: t_Vec_u8_Global) (return (x: t_Result_String_FromUtf8Error)) = any
  [ return (result: t_Result_String_FromUtf8Error) ->
  {[@stop_split] [@expl:from_utf8 ensures] ([@stop_split] [@expl:from_utf8 result type invariant] inv_Result_String_FromUtf8Error result)
    /\ ([@stop_split] [@expl:from_utf8 ensures] [%#sutf8'3] match result with
      | Ok s -> valid (view_Vec_u8_Global bytes) /\ to_bytes (view_String s) = view_Vec_u8_Global bytes
      | Err _ -> not valid (view_Vec_u8_Global bytes)
      end)}
    (! return {result}) ]

let unwrap_String (self_: t_Result_String_FromUtf8Error) (return (x: t_String)) =
{[@stop_split] [@expl:unwrap_String requires] ([@stop_split] [@expl:unwrap 'self_' type invariant] [%#sresult] inv_Result_String_FromUtf8Error self_)
  /\ ([@stop_split] [@expl:unwrap requires] [%#sresult'0] exists t: t_String. self_ = Ok t)}
  any
  [ return (result: t_String) ->
  {[@stop_split] [@expl:unwrap_String ensures] ([@stop_split] [@expl:unwrap result type invariant] inv_String result)
    /\ ([@stop_split] [@expl:unwrap ensures] [%#sresult'1] Ok result = self_)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let do_unindent [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/lib.rs" 167 0 167 49] (s: string)
  (preserve: bool) (return (x: t_String)) = (! bb0
  [ bb0 = s0
    [ s0 = as_bytes [%#slib] {s} (fun (_x: Slice64.slice UInt8.t) -> [ &bytes <- _x ] s1)
    | s1 = do_unindent_bytes [%#slib'0] {bytes} {preserve} (fun (_x: t_Vec_u8_Global) -> [ &out <- _x ] s2)
    | s2 =
      {[@expl:assertion] [%#slib'1] let _ = source_erasure (Slice64.view bytes) preserve (view_Vec_u8_Global out) in true}
      s3
    | s3 = {[@expl:assertion] [%#slib'2] valid (Slice64.view bytes)} s4
    | s4 = {[@expl:assertion] [%#slib'3] let _ = valid_erasure (Slice64.view bytes) (view_Vec_u8_Global out) in true} s5
    | s5 = from_utf8 [%#slib'4] {out} (fun (_x: t_Result_String_FromUtf8Error) -> [ &_25 <- _x ] s6)
    | s6 = unwrap_String [%#slib'5] {_25} (fun (_x: t_String) -> [ &_ret <- _x ] s7)
    | s7 = return {_ret} ] ]
  [ & _ret: t_String = Any.any_l ()
  | & s: string = s
  | & preserve: bool = preserve
  | & bytes: Slice64.slice UInt8.t = Any.any_l ()
  | & out: t_Vec_u8_Global = Any.any_l ()
  | & _25: t_Result_String_FromUtf8Error = Any.any_l () ])
  [ return (result: t_String) ->
  {[@stop_split] [@expl:do_unindent ensures] ([@stop_split] [@expl:do_unindent result type invariant] [%#slib'6] inv_String result)
    /\ ([@stop_split] [@expl:do_unindent ensures #0] [%#slib'7] source_unindented (to_bytes (view_str s)) preserve (to_bytes (view_String result)))
    /\ ([@stop_split] [@expl:do_unindent ensures #1] [%#slib'8] Seq.length (to_bytes (view_String result))
    <= Seq.length (to_bytes (view_str s)))}
    (! return {result}) ]
