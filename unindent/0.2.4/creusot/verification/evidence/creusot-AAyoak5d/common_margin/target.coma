  | bb3 = s0 [ s0 = [ &_ret <- [%#slib'4] (0: UInt64.t) ] s1 | s1 = return {_ret} ]
  | bb4 = s0
    [ s0 = UInt64.add [%#slib'6] {line_start} {[%#slib'5] (1: UInt64.t)}
        (fun (_x: UInt64.t) -> [ &line_start <- _x ] s1)
    | s1 = bb5 ]
  | bb5 = bb5invariant
    [ bb5 = {[@expl:loop variant] well_founded_relation_Int variant_old_bb5 ([%#slib'7] Seq.length (Slice64.view s)
      - UInt64.t'int line_start)}
      bb5invariant
    | bb5invariant = {[@expl:loop invariant #0] [%#slib'15] UInt64.t'int line_start <= Seq.length (Slice64.view s)}
      {[@expl:loop invariant #1] [%#slib'14] 0 < UInt64.t'int line_start
      /\ Seq.get (Slice64.view s) (UInt64.t'int line_start - 1) = (10: UInt8.t)}
      {[@expl:loop invariant #2] [%#slib'13] minimum_prefix (Slice64.view s) (UInt64.t'int line_start) found_margin (UInt64.t'int spaces)}
      (! [ &variant_old_bb5 <- [%#slib'7] Seq.length (Slice64.view s) - UInt64.t'int line_start ] s0)
      [ s0 = line_end_index [%#slib'8] {s} {line_start} (fun (_x: UInt64.t) -> [ &line_end <- _x ] s1)
      | s1 = leading_end_index [%#slib'9] {s} {line_start} {line_end} (fun (_x: UInt64.t) -> [ &i <- _x ] s2)
      | s2 = {[@expl:assertion] [%#slib'10] forall a: int, k: int. later_candidate (Slice64.view s) a k
            /\ UInt64.t'int line_start <= a /\ a <= UInt64.t'int line_end -> a = UInt64.t'int line_start}
        s3
      | s3 = {[@expl:assertion] [%#slib'11] forall k: int. later_candidate (Slice64.view s) (UInt64.t'int line_start) k
          -> k = UInt64.t'int i /\ UInt64.t'int i < UInt64.t'int line_end}
        s4
      | s4 = {[@expl:assertion] [%#slib'12] UInt64.t'int i < UInt64.t'int line_end
        -> later_candidate (Slice64.view s) (UInt64.t'int line_start) (UInt64.t'int i)}
        s5
      | s5 = [ &_58 <- UInt64.lt i line_end ] s6
      | s6 = any [ br0 -> {_58 = false} (! bb16) | br1 -> {_58} (! bb9) ] ]
      [ bb9 = s0
