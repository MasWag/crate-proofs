use creusot.int.UInt64
use creusot.slice.Slice64
use creusot.int.UInt8
use seq.Seq
use creusot.prelude.Any
use int.Int

let line_end_index (s: Slice64.slice UInt8.t) (start: UInt64.t) (return (x: UInt64.t)) =
{[@stop_split] [@expl:line_end_index requires] [%#slib'23] UInt64.t'int start <= Seq.length (Slice64.view s)}
  any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:line_end_index ensures] ([@stop_split] [@expl:line_end_index ensures #0] [%#slib'24] UInt64.t'int start
        <= UInt64.t'int result
      /\ UInt64.t'int result <= Seq.length (Slice64.view s))
    /\ ([@stop_split] [@expl:line_end_index ensures #1] [%#slib'25] forall i: int. UInt64.t'int start <= i
          /\ i < UInt64.t'int result -> Seq.get (Slice64.view s) i <> (10: UInt8.t))
    /\ ([@stop_split] [@expl:line_end_index ensures #2] [%#slib'26] UInt64.t'int result < Seq.length (Slice64.view s)
    -> Seq.get (Slice64.view s) (UInt64.t'int result) = (10: UInt8.t))}
    (! return {result}) ]

let len_u8 (self_: Slice64.slice UInt8.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

let leading_end_index (s: Slice64.slice UInt8.t) (start: UInt64.t) (end': UInt64.t) (return (x: UInt64.t)) =
{[@stop_split] [@expl:leading_end_index requires] [%#slib'27] UInt64.t'int start <= UInt64.t'int end'
  /\ UInt64.t'int end' <= Seq.length (Slice64.view s)}
  any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:leading_end_index ensures] ([@stop_split] [@expl:leading_end_index ensures #0] [%#slib'28] UInt64.t'int start
        <= UInt64.t'int result
      /\ UInt64.t'int result <= UInt64.t'int end')
    /\ ([@stop_split] [@expl:leading_end_index ensures #1] [%#slib'29] forall i: int. UInt64.t'int start <= i
          /\ i < UInt64.t'int result
        -> Seq.get (Slice64.view s) i = (32: UInt8.t) \/ Seq.get (Slice64.view s) i = (9: UInt8.t))
    /\ ([@stop_split] [@expl:leading_end_index ensures #2] [%#slib'30] UInt64.t'int result < UInt64.t'int end'
    -> Seq.get (Slice64.view s) (UInt64.t'int result) <> (32: UInt8.t)
    /\ Seq.get (Slice64.view s) (UInt64.t'int result) <> (9: UInt8.t))}
    (! return {result}) ]

predicate white [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 5 0 5 27] (b: UInt8.t) =
  [%#sspec'1] b = (32: UInt8.t) \/ b = (9: UInt8.t)

predicate later_candidate [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 97 0 97 58] (s: Seq.seq UInt8.t) (a: int) (k: int) =
  [%#sspec] 0 < a
  /\ a <= k
  /\ k < Seq.length s
  /\ Seq.get s (a - 1) = (10: UInt8.t)
  /\ Seq.get s k <> (10: UInt8.t) /\ not white (Seq.get s k) /\ (forall j: int. a <= j /\ j < k -> white (Seq.get s j))

predicate minimum_prefix [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/lib.rs" 52 0 52 79] (s: Seq.seq UInt8.t) (bound: int) (found: bool) (margin: int) =
  [%#slib'31] ge_log_Int margin 0
  /\ found = (exists a: int, k: int. a < bound /\ later_candidate s a k)
  /\ (not found -> margin = 0)
  /\ (found -> (exists a: int, k: int. a < bound /\ later_candidate s a k /\ k - a = margin))
  /\ (forall a: int, k: int. a < bound /\ later_candidate s a k -> margin <= k - a)

predicate source_margin [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/spec.rs" 104 0 104 48] (s: Seq.seq UInt8.t) (m: int) =
  [%#sspec'0] 0 <= m
  /\ (m = 0 /\ (forall a: int, k: int. not later_candidate s a k)
  \/ (exists a: int, k: int. later_candidate s a k /\ m = k - a)
  /\ (forall a: int, k: int. later_candidate s a k -> m <= k - a))

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let common_margin [#"/home/lab8/mwaga/crate-proofs/unindent/0.2.4/creusot/src/lib.rs" 64 0 64 35]
  (s: Slice64.slice UInt8.t) (return (x: UInt64.t)) = (! bb0
  [ bb0 = s0
    [ s0 = [ &spaces <- [%#slib] (0: UInt64.t) ] s1
    | s1 = [ &found_margin <- [%#slib'0] false ] s2
    | s2 = line_end_index [%#slib'2] {s} {[%#slib'1] (0: UInt64.t)} (fun (_x: UInt64.t) -> [ &line_start <- _x ] s3)
    | s3 = len_u8 [%#slib'3] {s} (fun (_x: UInt64.t) -> [ &_13 <- _x ] s4)
