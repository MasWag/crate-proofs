  /\ (([@stop_split] [@expl:such_that ensures] [%#slogic'0] index_Mapping_Seq_Int_bool (fun (p: Seq.seq int) -> selection_trace source margin preserve (Seq.length source) p output) (such_that_Seq_Int (fun (p: Seq.seq int) -> selection_trace source margin preserve (Seq.length source) p output)))
  -> (let positions = such_that_Seq_Int (fun (p: Seq.seq int) -> selection_trace source margin preserve (Seq.length source) p output) in ([@stop_split] [@expl:all_nonascii_kept requires] [%#sutf8_trace'1] source_margin source margin)
