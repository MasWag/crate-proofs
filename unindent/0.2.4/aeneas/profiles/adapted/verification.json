{
  "schema_version": 1,
  "supported_targets": [
    "x86_64-unknown-linux-gnu"
  ],
  "native": [
    [
      "python3",
      "aeneas/profiles/adapted/scripts/prepare-source.py"
    ],
    [
      "python3",
      "aeneas/profiles/adapted/scripts/native-equivalence.py"
    ]
  ],
  "extractions": [
    {
      "config": "extraction.json",
      "cwd": ".work/adapted",
      "models": {
