{
  "schema_version": 1,
  "supported_targets": [
    "aarch64-apple-darwin"
  ],
  "native": [
    [
      "cargo",
      "test",
      "--locked"
    ],
    [
      "cargo",
      "test",
      "--locked",
      "--manifest-path",
      "verification/harness/Cargo.toml"
    ]
  ],
  "extractions": [
    {
      "config": "extraction.json",
      "models": {
        "OptionExt.lean": "proofs/Generated/@TARGET@/OptionExt.lean"
      }
    },
    {
      "config": "extraction-adapted.json",
      "cwd": "verification/harness",
      "models": {
        "OptionExtAdapted.lean": "proofs/Generated/@TARGET@/OptionExtAdapted.lean"
      }
    }
  ],
  "inventory": "theorems.json",
  "report": "proofs.toml",
  "lean_dir": "proofs",
  "additional_checks": [
    [
      "python3.11",
      "scripts/check-adaptation.py"
    ],
    [
      "python3.11",
      "scripts/check-original-blocker.py"
    ]
  ],
  "post_checks": [
    [
      "python3.11",
      "scripts/check-adaptation.py"
    ]
  ]
}
