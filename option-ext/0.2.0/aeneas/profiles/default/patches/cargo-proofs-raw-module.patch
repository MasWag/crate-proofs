+    #[test]
+    fn raw_identifier_modules_use_unescaped_paths() {
+        let (dir, p) = project("pub mod r#type; pub mod r#match { pub fn r#loop() {} }");
+        fs::write(dir.path().join("type.rs"), "pub fn r#fn() {}").unwrap();
+        let contracts = public_contracts(&p, false, CreusotTarget::All).unwrap();
+        let paths: BTreeSet<_> = contracts.iter().flat_map(|c| c.api_paths.iter().cloned()).collect();
+        assert!(paths.contains("type::fn"), "{paths:?}");
+        assert!(paths.contains("match::loop"), "{paths:?}");
+        assert_eq!(contracts.len(), 2);
+    }
