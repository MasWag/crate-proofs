{
  "schema_version": 1,
  "supported_targets": [
    "aarch64-apple-darwin"
  ],
  "native": [
    [
      "cargo",
      "test",
      "--locked",
      "--offline"
    ]
  ],
  "extractions": [
    {
      "config": "extraction.json",
      "cwd": ".",
      "models": {
        "Facade.lean": "proofs/Generated/@TARGET@/Facade.lean"
      }
    }
  ],
  "inventory": "theorems.json",
  "report": "proofs.toml",
  "lean_dir": "proofs",
  "additional_checks": [
    [
      "python3.11",
      "scripts/check-registry-sources.py",
      "--lock",
      "Cargo.lock"
    ],
    [
      "python3.11",
      "scripts/check-execution-config.py"
    ],
    [
      "python3.11",
      "scripts/check-facade-adaptation.py"
    ],
    [
      "python3.11",
      "scripts/check-original-facade-blocker.py"
    ],
    [
      "python3.11",
      "scripts/check-core-blockers.py"
    ]
  ],
  "post_checks": [
    [
      "python3.11",
      "scripts/check-registry-sources.py",
      "--lock",
      "Cargo.lock"
    ],
    [
      "python3.11",
      "scripts/check-execution-config.py"
    ],
    [
      "python3.11",
      "scripts/check-facade-adaptation.py"
    ]
  ]
}
