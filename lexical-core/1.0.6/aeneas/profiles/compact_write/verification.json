{
  "schema_version": 1,
  "supported_targets": [
    "aarch64-apple-darwin"
  ],
  "native": [
    [
      "cargo",
      "test",
      "--locked",
      "--offline",
      "--manifest-path",
      "verification/compact-write/Cargo.toml"
    ]
  ],
  "extractions": [
    {
      "config": "extraction.json",
      "cwd": ".",
      "models": {
        "CompactWrite.lean": "proofs/Generated/@TARGET@/CompactWrite.lean"
      }
    }
  ],
  "inventory": "theorems.json",
  "report": "proofs.toml",
  "lean_dir": "proofs",
  "additional_checks": [
    [
      "python3.11",
      "scripts/check-registry-sources.py",
      "--lock",
      "verification/compact-write/Cargo.lock"
    ],
    [
      "python3.11",
      "scripts/check-execution-config.py"
    ],
    [
      "python3.11",
      "verification/compact-write/derive.py"
    ],
    [
      "python3.11",
      "verification/compact-write/generate-cases.py"
    ]
  ],
  "post_checks": [
    [
      "python3.11",
      "scripts/check-registry-sources.py",
      "--lock",
      "verification/compact-write/Cargo.lock"
    ],
    [
      "python3.11",
      "scripts/check-execution-config.py"
    ],
    [
      "python3.11",
      "verification/compact-write/derive.py"
    ],
    [
      "python3.11",
      "verification/compact-write/generate-cases.py"
    ]
  ]
}
